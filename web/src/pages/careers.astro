---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import PhotoPair from '../components/content/PhotoPair.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import Field from '../components/forms/Field.astro';
import FileField from '../components/forms/FileField.astro';
import Button from '../components/core/Button.astro';
import Badge from '../components/content/Badge.astro';
import SectionHeading from '../components/content/SectionHeading.astro';
import { Check, Phone } from '@lucide/astro';
import { site } from '../lib/site';
import { url } from '../lib/paths';
import { getPage } from '../lib/pages';

// Everything on this page comes from "Plant Your Roots page" in the panel (src/content/pages/careers.yml).
const c = await getPage('careersPage');
// The form's choices follow the page: both stylist paths, every hourly role, and an open option.
const interests = ['Commission', 'Booth rental', ...c.hourlyRoles, 'Not sure yet'];
// Until a form address is set in the panel, applicants are asked to call (or email, if one is set) instead.
const applyOnline = site.careersFormEndpoint !== '';
const tel = `tel:${site.phone.replace(/[^\d+]/g, '')}`;
---


<BaseLayout title={c.seo.title} description={c.seo.description}>
  <PageHeader {...c.header} bg="var(--surface-chocolate)" />

  <Section>
    <div class="split">
      <div class="split__text">
        {c.badge && <Badge tone="terracotta">{c.badge}</Badge>}
        <p class="lead">{c.intro}</p>
        {c.offer && <p class="offer">{c.offer}</p>}
        <Button variant="outline" href={url('team/')}>{c.teamButton}</Button>
      </div>
      <div class="split__photo">
        <PhotoPair src={c.photo.image} alt={c.photo.alt} focus={c.photo.focus} src2={c.photo2?.image} alt2={c.photo2?.alt} focus2={c.photo2?.focus} side="end" />
      </div>
    </div>
    {c.photos.length > 0 && (
      <div class="pair">
        {c.photos.map((p) => <PhotoFrame framed="light" src={p.image} alt={p.alt} focus={p.focus} shape="rounded" ratio="4 / 5" sizes="(min-width: 900px) 46vw, 90vw" />)}
      </div>
    )}
  </Section>

  <Section bg="var(--surface-raised)">
    <h2 class="title-m h2">{c.perksTitle}</h2>
    <ul class="ticks ticks--cols">{c.perks.map((p) => <li><Check size={18} stroke-width={1.5} />{p}</li>)}</ul>

    <div class="paths">
      <article class="path">
        <h3 class="path__title">{c.commissionTitle}</h3>
        <ul class="ticks">{c.commission.map((p) => <li><Check size={18} stroke-width={1.5} />{p}</li>)}</ul>
      </article>
      <article class="path">
        <h3 class="path__title">{c.boothRentalTitle}</h3>
        {c.boothRentalPrice && <p class="path__price">{c.boothRentalPrice}</p>}
        <ul class="ticks">{c.boothRental.map((p) => <li><Check size={18} stroke-width={1.5} />{p}</li>)}</ul>
      </article>
      <article class="path">
        <h3 class="path__title">{c.hourlyTitle}</h3>
        {c.hourlyPrice && <p class="path__price">{c.hourlyPrice}</p>}
        <ul class="ticks">{c.hourlyRoles.map((p) => <li><Check size={18} stroke-width={1.5} />{p}</li>)}</ul>
      </article>
    </div>
  </Section>

  <Section bg="var(--surface-olive)" curve>
    <!-- The same heading as the love letters on the home page: small label, then the title with a handwritten phrase. -->
    <SectionHeading tone="dark" eyebrow={c.quotesEyebrow} title={c.quotesTitle} />
    <div class="quotes">
      {c.stylistQuotes.map((q) => (
        <figure class="quote">
          <blockquote>“{q.quote}”</blockquote>
          <figcaption>{q.name}</figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <Section>
    {applyOnline ? (
    <div class="apply">
      <div class="apply__intro">
        <h2 class="title-m h2">{c.apply.title}</h2>
        {c.apply.text && <p>{c.apply.text}</p>}
        {c.apply.steps.length > 0 && (
        <div class="next">
          <span class="next__label">{c.apply.stepsTitle}</span>
          <ol class="next__list">
            {c.apply.steps.map((st, i) => (
              <li class="next__step">
                <span class="next__n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="next__title">{st.title}</h3>
                <p class="next__text">{st.text}</p>
              </li>
            ))}
          </ol>
        </div>
      )}
      </div>
      <ContactForm
        subject="Careers application"
        submitLabel="Send application"
        endpoint={site.careersFormEndpoint}
        multipart
        success="Thank you for applying. We have your application and will be in touch soon."
      >
        <Field label="Name" name="name" required />
        <Field label="Email" name="email" type="email" required />
        <Field label="Phone" name="phone" type="tel" />
        <Field label="I'm interested in" name="interest" type="select" options={interests} required />
        <Field label="Tell us about yourself" name="message" type="textarea" required />
        {site.uploadsReady && <FileField label="Resume" name="resume" hint="Optional. PDF, DOC or DOCX, up to 5 MB. We use it only to consider your application." />}
      </ContactForm>
    </div>
    ) : (
    <div class="apply apply--offline">
      <div class="apply__intro">
        <h2 class="title-m h2">{c.apply.title}</h2>
        <p class="apply__call">
          We would love to hear from you. Call us and tell us a little about yourself{site.email && <>, or email <a href={`mailto:${site.email}`}>{site.email}</a></>}.
        </p>
        <Button href={tel} size="lg"><Phone slot="icon" size={16} stroke-width={1.5} aria-hidden="true" />Call {site.phone}</Button>
      </div>
      {c.apply.steps.length > 0 && (
        <div class="next">
          <span class="next__label">{c.apply.stepsTitle}</span>
          <ol class="next__list">
            {c.apply.steps.map((st, i) => (
              <li class="next__step">
                <span class="next__n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="next__title">{st.title}</h3>
                <p class="next__text">{st.text}</p>
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>
    )}
  </Section>
</BaseLayout>

<style>
  .split { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .split__text { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .split__photo { width: 100%; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; margin-top: clamp(48px, 6vw, 80px); }
  .lead { margin: 0; font-size: var(--fs-body-l); }
  .offer { margin: 0; font-family: var(--font-display); font-size: 24px; line-height: 1.4; color: var(--text-strong); }
  .h2 { margin-bottom: 32px; }
  .h2--dark { text-align: center; }
  .ticks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .ticks li { display: flex; gap: 12px; align-items: flex-start; }
  .ticks li :global(svg) { flex-shrink: 0; margin-top: 4px; color: var(--text-accent); }
  .ticks--cols { display: block; columns: 2; column-gap: 48px; margin-bottom: 56px; }
  .ticks--cols li { break-inside: avoid; margin-bottom: 10px; }
  .paths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .path { padding: 32px 28px; border-radius: var(--radius-lg); background: var(--surface-sand); display: flex; flex-direction: column; gap: 14px; }
  .path__title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 26px; line-height: var(--lh-snug); color: var(--text-strong); }
  .path__price { margin: 0; font-family: var(--font-display); font-size: 22px; line-height: var(--lh-snug); color: var(--rh-chocolate); }
  .quotes { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; max-width: 1000px; margin: 48px auto 0; }
  .quote { margin: 0; display: flex; flex-direction: column; gap: 14px; color: var(--rh-ivory); }
  .quote blockquote { margin: 0; font-family: var(--font-display); font-size: clamp(22px, 2vw, 26px); line-height: 1.45; text-wrap: pretty; }
  .quote figcaption { font-size: 12px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
  .apply { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .apply__intro { display: flex; flex-direction: column; align-items: flex-start; }
  .apply__intro p { margin: 0; }
  .apply--offline { grid-template-columns: 1fr 1fr; align-items: center; }
  .apply__intro .apply__call { margin-bottom: 28px; font-size: var(--fs-body-l); }
  /* What happens next: numbered like the groups on The Experience, with a fine line between steps like the price list. */
  .next { align-self: stretch; }
  .apply__intro .next { margin-top: 40px; }
  .next__label { display: block; margin-bottom: 14px; font-size: 12px; font-weight: 500; letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--text-accent); }
  .next__list { list-style: none; margin: 0; padding: 0; }
  .next__step { display: grid; grid-template-columns: 56px 1fr; gap: 4px 12px; padding: 22px 0; border-top: 1px solid var(--border-hairline); }
  .next__step:last-child { border-bottom: 1px solid var(--border-hairline); }
  .next__n { grid-row: span 2; font-family: var(--font-display); font-size: 32px; line-height: 1; color: var(--rh-terracotta); }
  .next__title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: var(--fs-title); line-height: var(--lh-snug); color: var(--text-strong); }
  .next__text { margin: 0; color: var(--text-muted); text-wrap: pretty; }
  @media (max-width: 900px) {
    .split, .apply, .apply--offline, .pair { grid-template-columns: 1fr; }
    .paths { grid-template-columns: 1fr; }
    .quotes { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .ticks--cols { columns: 1; } }
</style>
