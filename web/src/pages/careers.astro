---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import Field from '../components/forms/Field.astro';
import FileField from '../components/forms/FileField.astro';
import Button from '../components/core/Button.astro';
import Badge from '../components/content/Badge.astro';
import { Check } from '@lucide/astro';
import { site } from '../lib/site';
import { url } from '../lib/paths';
import careers from '../content/careers.json';
import headerPhoto from '../assets/photos/hero/img-9947.jpg';
import teamPhoto from '../assets/photos/stylists/img-9934.jpg';
---

<BaseLayout title="Plant Your Roots: careers · The Rooted Haus" description="Join The Rooted Haus in Mandeville: commission, booth rental and hourly opportunities in a calm, low-tox salon.">
  <PageHeader eyebrow="Plant your roots" script="come grow with us" title={careers.title} bg="var(--surface-chocolate)" image={headerPhoto} imageAlt="A stylist in a wide-brim hat paints in foils for a smiling client." focus="58% 40%" />

  <Section>
    <div class="split">
      <div class="split__text">
        <Badge tone="terracotta">Now hiring</Badge>
        <p class="lead">{careers.intro}</p>
        <p class="offer">{careers.offer}</p>
        <Button variant="outline" href={url('team/')}>Meet the Haus</Button>
      </div>
      <div class="split__photo">
        <PhotoFrame src={teamPhoto} alt="Sadie laughs as she spins in a salon chair." shape="rounded" ratio="4 / 5" focus="50% 30%" sizes="(min-width: 900px) 40vw, 90vw" />
      </div>
    </div>
  </Section>

  <Section bg="var(--surface-raised)">
    <h2 class="h2">Perks of working in our salon</h2>
    <ul class="ticks ticks--cols">{careers.perks.map((p) => <li><Check size={18} stroke-width={1.5} />{p}</li>)}</ul>

    <div class="paths">
      <article class="path">
        <h3 class="path__title">Commission stylists</h3>
        <ul class="ticks">{careers.commission.map((p) => <li><Check size={18} stroke-width={1.5} />{p}</li>)}</ul>
      </article>
      <article class="path">
        <h3 class="path__title">Booth rentals</h3>
        <p class="path__price">{careers.boothRentalPrice}</p>
        <ul class="ticks">{careers.boothRental.map((p) => <li><Check size={18} stroke-width={1.5} />{p}</li>)}</ul>
      </article>
      <article class="path">
        <h3 class="path__title">Hourly roles</h3>
        <p class="path__price">{careers.hourlyPrice}</p>
        <ul class="ticks">{careers.hourlyRoles.map((p) => <li><Check size={18} stroke-width={1.5} />{p}</li>)}</ul>
      </article>
    </div>
  </Section>

  <Section bg="var(--surface-olive)">
    <h2 class="h2 h2--dark">Here’s what our stylists have to say!</h2>
    <div class="quotes">
      {careers.stylistQuotes.map((q) => (
        <figure class="quote">
          <blockquote>“{q.quote}”</blockquote>
          <figcaption>{q.name}</figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <Section>
    <div class="apply">
      <div class="apply__intro">
        <h2 class="h2">Apply to join the Haus</h2>
        <p>Tell us about yourself and what you are looking for. A resume is welcome but not required.</p>
      </div>
      <ContactForm
        subject="Careers application"
        submitLabel="Send application"
        endpoint={site.careersFormEndpoint}
        multipart
        success="Thank you for applying. We have your application and will be in touch soon."
      >
        <Field label="Name" name="name" required />
        <Field label="Email" name="email" type="email" required />
        <Field label="Phone" name="phone" type="tel" />
        <Field label="I'm interested in" name="interest" type="select" options={['Commission', 'Booth rental', 'Salon Assistant', 'Front Desk Coordinator', 'Not sure yet']} required />
        <Field label="Tell us about yourself" name="message" type="textarea" required />
        <FileField label="Resume" name="resume" hint="Optional. PDF, DOC or DOCX, up to 5 MB. We use it only to consider your application." />
      </ContactForm>
    </div>
  </Section>
</BaseLayout>

<style>
  .split { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .split__text { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .split__photo { width: 100%; }
  .lead { margin: 0; font-size: var(--fs-body-l); }
  .offer { margin: 0; font-family: var(--font-display); font-size: 24px; color: var(--text-strong); }
  .h2 { margin: 0 0 32px; font-family: var(--font-display); font-weight: 400; font-size: clamp(28px, 3.4vw, var(--fs-display-m)); color: var(--text-strong); }
  .h2--dark { color: var(--rh-ivory); text-align: center; }
  .ticks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .ticks li { display: flex; gap: 12px; align-items: flex-start; }
  .ticks li :global(svg) { flex-shrink: 0; margin-top: 4px; color: var(--text-accent); }
  .ticks--cols { display: block; columns: 2; column-gap: 48px; margin-bottom: 56px; }
  .ticks--cols li { break-inside: avoid; margin-bottom: 10px; }
  .paths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .path { padding: 32px 28px; border-radius: var(--radius-lg); background: var(--surface-sand); display: flex; flex-direction: column; gap: 14px; }
  .path__title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 26px; color: var(--text-strong); }
  .path__price { margin: 0; font-family: var(--font-display); font-size: 22px; color: var(--rh-chocolate); }
  .quotes { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; max-width: 1000px; margin: 0 auto; }
  .quote { margin: 0; display: flex; flex-direction: column; gap: 14px; color: var(--rh-ivory); }
  .quote blockquote { margin: 0; font-family: var(--font-display); font-size: 22px; line-height: 1.45; }
  .quote figcaption { font-size: 12px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
  .apply { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .apply__intro p { margin: 0; }
  @media (max-width: 900px) {
    .split, .apply { grid-template-columns: 1fr; }
    .paths { grid-template-columns: 1fr; }
    .quotes { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .ticks--cols { columns: 1; } }
</style>
