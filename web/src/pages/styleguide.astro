---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import SectionHeading from '../components/content/SectionHeading.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import Card from '../components/content/Card.astro';
import Badge from '../components/content/Badge.astro';
import ReviewCard from '../components/content/ReviewCard.astro';
import Button from '../components/core/Button.astro';
import Field from '../components/forms/Field.astro';

const palette = [
  ['chocolate', '#593E2B'], ['sage', '#A6A680'], ['sand', '#E8D4B9'], ['caramel', '#BF7B3F'],
  ['terracotta', '#8C5637'], ['olive', '#727259'], ['ivory', '#FFF4E1'],
  ['espresso', '#3B2819'], ['linen', '#F3ECE2'], ['oat', '#F7E9D3'],
];
---

<BaseLayout title="Styleguide · The Rooted Haus" noindex>
  <Section>
    <SectionHeading align="left" eyebrow="Internal" title="Styleguide" intro="Every component rendered from the design tokens, for side-by-side comparison with the design system project. Not linked from the site and hidden from search." />
  </Section>

  <Section bg="var(--surface-raised)">
    <h2 class="h">Color</h2>
    <div class="swatches">
      {palette.map(([name, hex]) => (
        <div class="swatch"><span class="swatch__chip" style={`background:var(--rh-${name})`} /><strong>{name}</strong><span>{hex}</span></div>
      ))}
    </div>
  </Section>

  <Section>
    <h2 class="h">Type</h2>
    <p style="font-family:var(--font-display);font-size:var(--fs-display-l);line-height:1.1;margin:0">Display: healthy hair starts at the scalp</p>
    <p style="font-family:var(--font-script);font-size:var(--fs-script-m);line-height:1.1;margin:12px 0;color:var(--text-script)">script: come as you are</p>
    <p style="font-size:var(--fs-body-l);max-width:60ch">Body (Montserrat): We look at your scalp, your routine and what goes into your products before we pick up the scissors.</p>
    <p style="font-size:12px;font-weight:500;letter-spacing:var(--ls-eyebrow);text-transform:uppercase;color:var(--text-accent)">Eyebrow label</p>
    <SectionHeading align="left" eyebrow="Section heading" script="more than hair" title="A slower, more thoughtful salon visit" intro="Intro paragraph in muted body text." />
  </Section>

  <Section bg="var(--surface-moody)">
    <h2 class="h h--dark">Buttons and badges</h2>
    <div class="row">
      <Button>Primary</Button><Button variant="secondary">Secondary</Button><Button variant="ivory">Ivory</Button>
      <Button variant="outline" tone="dark">Outline</Button><Button variant="text" tone="dark">Text link</Button>
    </div>
    <div class="row">
      <Button size="sm">Small</Button><Button size="md">Medium</Button><Button size="lg">Large</Button>
    </div>
    <div class="row">
      <Badge tone="terracotta">Terracotta</Badge><Badge tone="olive">Olive</Badge><Badge tone="sand">Sand</Badge>
      <Badge tone="sage">Sage</Badge><Badge tone="ivory">Ivory</Badge>
    </div>
  </Section>

  <Section>
    <h2 class="h">Cards and photo shapes</h2>
    <div class="grid3">
      <Card interactive surface="sand" title="Sand card" price="$—">Hover to lift.</Card>
      <Card interactive surface="sage" title="Sage card">Flat fill, no border.</Card>
      <Card interactive surface="terracotta" title="Terracotta card">Light text on dark fill.</Card>
    </div>
    <div class="grid4">
      <PhotoFrame shape="arch" label="arch" /><PhotoFrame shape="circle" label="circle" />
      <PhotoFrame shape="rounded" label="rounded" /><PhotoFrame shape="soft" label="soft" />
    </div>
  </Section>

  <Section bg="var(--surface-olive)">
    <div class="grid2">
      <ReviewCard tone="dark" quote="A review on a dark surface." name="Client name" detail="Google review" />
      <ReviewCard tone="dark" quote="A second review, for rhythm." name="Client name" detail="Google review" rating={4} />
    </div>
  </Section>

  <Section bg="var(--surface-sand)">
    <h2 class="h">Form fields</h2>
    <div class="form">
      <Field label="Text" name="sg-text" placeholder="Placeholder" />
      <Field label="Select" name="sg-select" type="select" options={['One', 'Two']} />
      <Field label="Message" name="sg-area" type="textarea" />
    </div>
  </Section>
</BaseLayout>

<style>
  .h { margin: 0 0 28px; font-family: var(--font-display); font-weight: 400; font-size: var(--fs-display-m); color: var(--text-strong); }
  .h--dark { color: var(--rh-ivory); }
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 20px; }
  .swatch { display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
  .swatch__chip { height: 72px; border-radius: var(--radius-md); border: 1px solid var(--border-hairline); }
  .row { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-bottom: 24px; }
  .grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-bottom: 40px; }
  .grid4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; align-items: end; }
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; }
  .form { display: flex; flex-direction: column; gap: 20px; max-width: 480px; }
</style>
