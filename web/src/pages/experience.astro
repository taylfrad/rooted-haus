---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/content/SectionHeading.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import PhotoPair from '../components/content/PhotoPair.astro';
import BookButton from '../components/core/BookButton.astro';
import Button from '../components/core/Button.astro';
import { url } from '../lib/paths';
import { site } from '../lib/site';
import { getPage } from '../lib/pages';

const page = await getPage('experiencePage');

// Each group ("A warm welcome", "The rooted difference"...) is one file in src/content/experience: its photos and its points.
const groups = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
// Photo shapes alternate down the page so the groups don't feel repetitive, and no two arches sit side by side:
// a group with two photos overlaps them (large + small), and each such group uses the next arrangement below.
const shapes = ['arch', 'rounded'] as const;
const pairings = [
  { shape: 'arch', shape2: 'rounded', side: 'start' },
  { shape: 'rounded', shape2: 'circle', side: 'end' },
] as const;
let pairCount = 0;
const rows = groups.map(({ data }) => ({ g: data, pairing: data.image2 ? pairings[pairCount++ % pairings.length] : undefined }));
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <PageHeader {...page.header} />

  <Section bg="var(--surface-terracotta)">
    <div class="rows">
      {page.opening && (
        <div class="opening">
          <SectionHeading tone="dark" eyebrow={page.opening.eyebrow} title={page.opening.title} intro={page.opening.text} />
        </div>
      )}
      {rows.map(({ g, pairing }, i) => (
        <article class:list={['row', { 'row--flip': i % 2 === 1, 'row--large': g.wide || g.image2 }]} data-reveal>
          <!-- The photos stay beside the list while it scrolls past, as the photo column does on The Rituals. -->
          <div class="row__photo">
            {pairing ? (
              <PhotoPair framed="dark" ring="var(--surface-terracotta)" src={g.image} alt={g.alt ?? ''} src2={g.image2} alt2={g.alt2 ?? ''} label={g.title} {...pairing} />
            ) : g.wide && g.image ? (
              <PhotoFrame framed="dark" src={g.image} alt={g.alt ?? ''} shape="rounded" ratio={`${g.image.width} / ${g.image.height}`} sizes="(min-width: 900px) 50vw, 90vw" />
            ) : (
              <PhotoFrame framed="dark" src={g.image} alt={g.alt ?? ''} label={g.title} shape={shapes[i % shapes.length]} ratio="4 / 5" sizes="(min-width: 900px) 40vw, 90vw" />
            )}
          </div>
          <div class="row__text">
            <span class="row__n">{String(i + 1).padStart(2, '0')}</span>
            {g.eyebrow && <span class="row__eyebrow">{g.eyebrow}</span>}
            <h2 class="row__title">{g.title}</h2>
            {g.body && <p class="row__body">{g.body}</p>}
            {g.items.length > 0 && (
              <ul class="points">
                {g.items.map((p) => (
                  <li class="point">
                    <h3 class="point__title">{p.title}</h3>
                    <p class="point__text">{p.text}</p>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </Section>

  <Section bg="var(--surface-chocolate)" center curve>
    <div class="closing">
      {page.closing.script && <span class="closing__script">{page.closing.script}</span>}
      <p class="closing__line">{page.closing.text}</p>
      <div class="closing__actions">
        <BookButton variant="ivory" size="lg">{site.bookLabel}</BookButton>
        <Button variant="outline" tone="dark" size="lg" href={url('services/')}>{page.closing.ritualsButton}</Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  /* Pulled up toward the heading: both sections are the same color, so their padding would add up to a big empty band. */
  .rows { display: flex; flex-direction: column; gap: clamp(72px, 9vw, 128px); margin-top: calc(var(--section-y) * -.5); }
  .opening { display: flex; justify-content: center; }
  .opening :global(.sh__intro) { max-width: 720px; }
  .row { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .row--flip .row__photo { order: 2; }
  /* Photos sit on the outer content edge (left, or right on flipped rows) so every row shares the page grid. */
  .row__photo { max-width: 460px; width: 100%; justify-self: start; position: sticky; top: 118px; }
  .row--large { grid-template-columns: 1.15fr 1fr; }
  .row--large.row--flip { grid-template-columns: 1fr 1.15fr; }
  .row--large .row__photo { max-width: none; }
  .row--flip .row__photo { justify-self: end; }
  .row__text { display: flex; flex-direction: column; gap: 12px; }
  .row__n { display: flex; align-items: center; gap: 16px; font-family: var(--font-display); font-size: 40px; line-height: 1; color: var(--rh-caramel-soft); }
  .row__n::after { content: ''; width: 56px; height: 1px; background: var(--rh-sand); }
  .row__eyebrow { font-size: 12px; font-weight: 500; letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--rh-ivory); }
  .row__title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(30px, 3.6vw, var(--fs-display-l)); line-height: var(--lh-tight); color: var(--rh-ivory); }
  .row__body { margin: 0; font-size: var(--fs-body-l); color: var(--rh-ivory); }
  /* The points read like the price list on The Rituals: a fine line between each. */
  .points { list-style: none; margin: 16px 0 0; padding: 0; }
  .point { padding: 22px 0; border-top: 1px solid var(--border-on-dark); }
  .point:last-child { border-bottom: 1px solid var(--border-on-dark); }
  .point__title { margin: 0 0 8px; font-family: var(--font-display); font-weight: 400; font-size: var(--fs-title); line-height: var(--lh-snug); color: var(--rh-ivory); }
  .point__text { margin: 0; color: var(--rh-ivory); text-wrap: pretty; }
  .closing { max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .closing__script { font-family: var(--font-script); font-size: var(--fs-script-s); color: var(--rh-caramel-soft); }
  .closing__line { margin: 0; font-family: var(--font-display); font-size: clamp(24px, 2.8vw, 34px); line-height: 1.35; color: var(--rh-ivory); text-wrap: balance; }
  .closing__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 8px; }
  @media (max-width: 900px) {
    .row, .row--large, .row--large.row--flip { grid-template-columns: 1fr; }
    .closing__script { font-size: 40px; line-height: 1.15; text-wrap: balance; }
    .row--flip .row__photo { order: 0; }
    .row__photo, .row--flip .row__photo { position: static; max-width: 380px; justify-self: center; }
    .row--large .row__photo, .row--large.row--flip .row__photo { max-width: none; justify-self: stretch; }
  }
</style>
