---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import SectionHeading from '../components/content/SectionHeading.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import ReviewCard from '../components/content/ReviewCard.astro';
import Badge from '../components/content/Badge.astro';
import Button from '../components/core/Button.astro';
import BookButton from '../components/core/BookButton.astro';
import DealBanner from '../components/DealBanner.astro';
import Marquee from '../components/Marquee.astro';
import PhotoPair from '../components/content/PhotoPair.astro';
import { ChevronLeft, ChevronRight } from '@lucide/astro';
import { emphasis } from '../lib/emphasis';
import { url } from '../lib/paths';
import { site } from '../lib/site';
import { getPage } from '../lib/pages';
import { cropPosition } from '../lib/crop';

// All words and photos come from the "Home page" entry in the panel (src/content/pages/home.yml).
const home = await getPage('homePage');
// Slides: photo, a script phrase, crop anchor, and which side the text sits on (the side away from the faces).
const slides = home.hero.slides.map((s) => ({ ...s, position: cropPosition(s.focus) }));
const heroWidths = [640, 960, 1280, 1920, 2400];

// The three steps always link to the team, the menu and booking; only their words are edited.
const steps: { title: string; text: string; button: string; image?: ImageMetadata; alt: string; focus?: string; href?: string; book?: boolean }[] = [
  { ...home.steps.meet, href: url('team/') },
  { ...home.steps.rituals, href: url('services/') },
  { ...home.steps.book, book: true },
];

const specialties = home.specialties.items;
const experience = home.experience;

const reviews = (await getCollection('reviews')).filter((r) => r.data.featured);
// Love letters are shown one at a time; the one marked "Feature this one large" in the panel goes first.
const lead = reviews.find((r) => r.data.highlight) ?? reviews[0];
const letters = lead ? [lead, ...reviews.filter((r) => r !== lead)] : [];
const team = await getCollection('team');
const stylistName = (slug?: string) => team.find((t) => t.id === slug)?.data.name;
// Recent work is hair work only, and skips any photo already shown higher on this page, so nothing repeats.
// Square side-by-side before/afters are left out too: this section's tall frames would cut them in half.
const usedOnHome = new Set([...slides.map((s) => s.image.src), ...steps.map((s) => s.image?.src), ...specialties.map((s) => s.image?.src), experience.image?.src, experience.image2?.src]);
const recent = (await getCollection('gallery'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((g) => ['color', 'styling', 'results'].includes(g.data.tag))
  .filter((g) => !g.data.image || (!usedOnHome.has(g.data.image.src) && g.data.image.width !== g.data.image.height))
  .slice(0, 4);
---

<BaseLayout title={home.seo.title} description={home.seo.description}>
  <section class="hero" data-align={slides[0].side} aria-roledescription="carousel" aria-label="Welcome to The Rooted Haus">
    <!-- First photo is in the page; the other three wait in a <template> and are added after the page has loaded,
         so they never compete with the first photo (the page's largest paint). Without JavaScript the first photo stays. -->
    <div class="hero__slide" data-slide data-align={slides[0].side} data-active="true">
      <Image src={slides[0].image} alt={slides[0].alt} widths={heroWidths} sizes="100vw" loading="eager" fetchpriority="high" class="hero__img" style={slides[0].position && `object-position:${slides[0].position}`} />
    </div>
    <template data-more-slides>
      {slides.slice(1).map((s) => (
        <div class="hero__slide" data-slide data-align={s.side} data-active="false" aria-hidden="true">
          <Image src={s.image} alt={s.alt} widths={heroWidths} sizes="100vw" class="hero__img" style={s.position && `object-position:${s.position}`} />
        </div>
      ))}
    </template>
    <div class="hero__top" aria-hidden="true"></div>
    <div class="hero__shade hero__shade--left" aria-hidden="true"></div>
    <div class="hero__shade hero__shade--right" aria-hidden="true"></div>
    <div class="hero__content">
      <div class="hero__eyebrow"><span>{home.hero.eyebrow}</span></div>
      <div class="hero__scripts">
        {slides.map((s, i) => <span class="hero__script" data-phrase data-active={i === 0}>{s.phrase}</span>)}
      </div>
      <h1 class="hero__title" data-lines>{emphasis(home.hero.title).map((p) => (p.accent ? <em class="accent">{p.text}</em> : p.text))}</h1>
      <div class="hero__actions">
        <BookButton variant="ivory" size="lg">{site.bookLabel}</BookButton>
        <Button variant="outline" tone="dark" size="lg" href={url('services/')}>{home.hero.ritualsButton}</Button>
      </div>
    </div>
    <div class="hero__dots">
      {slides.map((_, i) => <button type="button" data-dot aria-label={`Show photo ${i + 1} of ${slides.length}`} data-active={i === 0}></button>)}
    </div>
  </section>

  <DealBanner />

  <Section>
    <SectionHeading eyebrow={home.steps.eyebrow} script={home.steps.script} title={home.steps.title} />
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <div class="step__photo">
            <PhotoFrame src={s.image} alt={s.alt} label={s.title} focus={s.focus} shape="rounded" ratio="5 / 4" sizes="(min-width: 900px) 30vw, 90vw" />
            <div class="step__tab">
              <span class="step__n">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="step__title">{s.title}</h3>
            </div>
          </div>
          <p class="step__text">{s.text}</p>
          {s.book ? <BookButton variant="text">{s.button}</BookButton> : <Button variant="text" href={s.href}>{s.button}</Button>}
        </li>
      ))}
    </ol>
  </Section>

  <Marquee items={specialties.map((s) => s.label)} />

  <Section bg="var(--surface-raised)">
    <SectionHeading eyebrow={home.specialties.eyebrow} script={home.specialties.script} title={home.specialties.title} />
    <ul class="specialties">
      {specialties.map((s) => (
        <li class="sp">
          <a class="sp__link lift-host" href={url('services/')}>
            <div class="sp__photo lift"><PhotoFrame src={s.image} alt={s.alt} label={s.label} focus={s.focus} shape="rounded" ratio="4 / 5" sizes="(min-width: 900px) 22vw, 45vw" /></div>
            <span class="sp__label">{s.label}</span>
          </a>
        </li>
      ))}
      <li class="sp sp--cta">
        <a class="sp__cta" href={url('services/')}>
          {home.specialties.card.script && <span class="sp__cta-script">{home.specialties.card.script}</span>}
          <span class="sp__cta-title">{home.specialties.card.title}</span>
          {home.specialties.card.text && <span class="sp__cta-text">{home.specialties.card.text}</span>}
        </a>
      </li>
    </ul>
  </Section>

  <Section bg="var(--surface-sand)">
    <div class="split split--flip">
      <div class="split__text">
        <SectionHeading
          align="left"
          eyebrow={experience.eyebrow}
          script={experience.script}
          title={experience.title}
          intro={experience.text}
        />
        <Button variant="outline" href={url('experience/')}>{experience.button}</Button>
      </div>
      <div class="split__photo">
        <PhotoPair src={experience.image} alt={experience.alt} focus={experience.focus} src2={experience.image2} alt2={experience.alt2} focus2={experience.focus2} ring="var(--surface-sand)" />
      </div>
    </div>
  </Section>

  <Section bg="var(--surface-moody)" curve>
    <SectionHeading tone="dark" eyebrow={home.reviews.eyebrow} script={home.reviews.script} title={home.reviews.title} />
    <!-- One love letter at a time. Without JavaScript they are simply listed one under another. -->
    <div class="letters" data-letters aria-roledescription="carousel" aria-label="Love letters from our clients">
      <div class="letters__stage">
        {letters.map((r, i) => (
          <div class="letter" data-letter data-active={i === 0}>
            <ReviewCard tone="dark" quote={r.data.quote} name={r.data.name} detail={r.data.stylist ? `with ${stylistName(r.data.stylist)}` : r.data.detail} rating={r.data.rating} />
          </div>
        ))}
      </div>
      {letters.length > 1 && (
        <div class="letters__nav">
          <button type="button" class="letters__arrow" data-letter-prev aria-label="Previous love letter"><ChevronLeft size={20} stroke-width={1.5} /></button>
          <div class="letters__dots">
            {letters.map((_, i) => <button type="button" data-letter-dot aria-label={`Love letter ${i + 1} of ${letters.length}`} data-active={i === 0}></button>)}
          </div>
          <button type="button" class="letters__arrow" data-letter-next aria-label="Next love letter"><ChevronRight size={20} stroke-width={1.5} /></button>
        </div>
      )}
    </div>
  </Section>

  <Section>
    <div class="work__head">
      <SectionHeading align="left" eyebrow={home.work.eyebrow} script={home.work.script} title={home.work.title} />
      <Button variant="outline" href={url('gallery/')}>{home.work.button}</Button>
    </div>
    <div class="work__grid">
      {recent.map((g) => (
        <PhotoFrame src={g.data.image} alt={g.data.alt ?? g.data.label} label={g.data.label} shape="soft" ratio="3 / 4" sizes="(min-width: 900px) 25vw, 50vw" />
      ))}
    </div>
  </Section>

  <Section bg="var(--surface-terracotta)" center curve>
    <div class="hiring">
      {home.hiring.badge && <Badge tone="ivory">{home.hiring.badge}</Badge>}
      <SectionHeading tone="dark" eyebrow={home.hiring.eyebrow} script={home.hiring.script} title={home.hiring.title} intro={home.hiring.text} />
      <Button variant="ivory" href={url('careers/')}>{home.hiring.button}</Button>
    </div>
  </Section>
</BaseLayout>

<script>
  // Love letters: one at a time, moving on every 8 seconds. It waits while the guest is reading (pointer or keyboard
  // focus on it), while it is off screen, and in a background tab; with reduced motion it only moves when asked.
  let lettersTimer: number | undefined;
  document.addEventListener('astro:page-load', () => {
    window.clearInterval(lettersTimer);
    const root = document.querySelector<HTMLElement>('[data-letters]');
    if (!root) return; // not the home page
    const letters = [...root.querySelectorAll<HTMLElement>('[data-letter]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-letter-dot]')];
    if (letters.length < 2) return;
    let current = 0;
    let onScreen = false;
    let reading = false;

    const show = (i: number) => {
      current = (i + letters.length) % letters.length;
      letters.forEach((el, k) => {
        el.dataset.active = String(k === current);
        el.toggleAttribute('aria-hidden', k !== current);
      });
      dots.forEach((d, k) => (d.dataset.active = String(k === current)));
    };
    const resume = () => {
      window.clearInterval(lettersTimer);
      if (!root.isConnected) return document.removeEventListener('visibilitychange', resume); // left the home page
      if (!onScreen || reading || document.hidden || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      lettersTimer = window.setInterval(() => show(current + 1), 8000);
    };
    // A letter the guest picked restarts the wait, so it is not swapped out from under them.
    const go = (i: number) => {
      show(i);
      resume();
    };

    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    root.querySelector('[data-letter-prev]')?.addEventListener('click', () => go(current - 1));
    root.querySelector('[data-letter-next]')?.addEventListener('click', () => go(current + 1));
    const setReading = (value: boolean) => () => {
      reading = value;
      resume();
    };
    root.addEventListener('pointerenter', setReading(true));
    root.addEventListener('pointerleave', setReading(false));
    root.addEventListener('focusin', setReading(true));
    root.addEventListener('focusout', setReading(false));
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      resume();
    }).observe(root);
    document.addEventListener('visibilitychange', resume);
    show(0);
  });

  // Hero: cross-fades photos every 6s (design system: 1.2s cross-fade). Static when reduced motion is on.
  // Guests can also swipe between photos on touch screens, or tap the dots.
  let timer: number | undefined;
  const SWIPE_MIN = 40; // px of sideways travel before a touch counts as a swipe

  const whenSettled = (fn: () => void) => {
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 800));
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  };

  document.addEventListener('astro:page-load', () => {
    window.clearInterval(timer);
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero) return; // not the home page
    whenSettled(() => {
      const more = hero.querySelector<HTMLTemplateElement>('template[data-more-slides]');
      if (more) {
        hero.querySelector('.hero__shade--left')!.before(more.content.cloneNode(true));
        more.remove();
      }
      hero.classList.add('has-slides');
      initSlideshow(hero);
    });
  });

  function initSlideshow(hero: HTMLElement) {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const phrases = [...document.querySelectorAll<HTMLElement>('[data-phrase]')];
    const dots = [...document.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let current = 0;

    let swap: number | undefined;

    function show(i: number) {
      current = i;
      [slides, phrases, dots].forEach((set) => set.forEach((el, k) => el.setAttribute('data-active', String(k === i))));
      const side = slides[i].dataset.align ?? 'left';
      if (side !== hero.dataset.align) {
        // Fade the text out, switch sides while it is invisible, then fade it back in.
        hero.classList.add('is-moving');
        window.clearTimeout(swap);
        swap = window.setTimeout(() => {
          hero.dataset.align = side;
          hero.classList.remove('is-moving');
        }, 450);
      }
      slides.forEach((el, k) => el.toggleAttribute('aria-hidden', k !== i));
    }
    function start() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      timer = window.setInterval(() => {
        hero.classList.remove('is-manual');
        show((current + 1) % slides.length);
      }, 6000);
    }
    // A photo the guest picked (dot or swipe) fades in quickly and restarts the 6s timer.
    function go(i: number) {
      window.clearInterval(timer);
      hero.classList.add('is-manual');
      show((i + slides.length) % slides.length);
      start();
    }
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

    // Swipe left for the next photo, right for the previous one. Mouse drags are ignored, and so are
    // touches that start on a button, so the booking buttons and dots still work normally.
    let startX = 0;
    let startY = 0;
    let tracking = false;
    hero.addEventListener('pointerdown', (e) => {
      tracking = e.pointerType !== 'mouse' && !(e.target as Element).closest('a, button');
      startX = e.clientX;
      startY = e.clientY;
    });
    hero.addEventListener('pointercancel', () => (tracking = false));
    hero.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - startX;
      if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) < Math.abs(e.clientY - startY)) return;
      go(current + (dx < 0 ? 1 : -1));
    });

    // Scrolled past, or in a background tab, nobody sees the cross-fade: stop the timer until the hero is back.
    let onScreen = true;
    const resume = () => {
      if (!hero.isConnected) return document.removeEventListener('visibilitychange', resume); // left the home page
      window.clearInterval(timer);
      if (onScreen && !document.hidden) start();
    };
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      resume();
    }).observe(hero);
    document.addEventListener('visibilitychange', resume);
  }
</script>

<style>
  /* Exactly one screen tall on every device. svh is the height with a phone's browser bars showing, so
     the hero fits on load and does not resize while those bars slide away. */
  .hero { position: relative; height: 100vh; height: 100svh; overflow: hidden; color: var(--rh-ivory); background: var(--rh-espresso);
    touch-action: pan-y pinch-zoom; /* the page still scrolls and zooms; sideways swipes go to the slideshow */ }
  .hero__slide { position: absolute; inset: 0; opacity: 0; transition: opacity var(--dur-slow) var(--ease-soft); }
  .hero__slide[data-active='true'] { opacity: 1; }
  .hero.is-manual .hero__slide, .hero.is-manual .hero__script { transition-duration: .5s; }
  .hero__img { width: 100%; height: 100%; object-fit: cover; filter: var(--photo-warmth); }
  /* Darkens the bottom-left corner where the text sits, so ivory text stays readable on any photo. */
  .hero__top { position: absolute; z-index: 1; left: 0; right: 0; top: 0; height: 200px; pointer-events: none;
    background: linear-gradient(180deg, rgba(59, 40, 25, .8) 0%, rgba(59, 40, 25, .62) 40%, rgba(59, 40, 25, 0) 100%); }
  .hero__shade { position: absolute; inset: 0; pointer-events: none; transition: opacity var(--dur-slow) var(--ease-soft); }
  .hero__shade--left {
    background:
      radial-gradient(ellipse 85% 120% at 0% 100%, rgba(59, 40, 25, .9) 0%, rgba(59, 40, 25, .72) 45%, rgba(59, 40, 25, 0) 80%),
      linear-gradient(0deg, rgba(59, 40, 25, .55) 0%, rgba(59, 40, 25, 0) 45%); }
  .hero__shade--right { opacity: 0;
    background:
      radial-gradient(ellipse 85% 120% at 100% 100%, rgba(59, 40, 25, .92) 0%, rgba(59, 40, 25, .78) 45%, rgba(59, 40, 25, 0) 82%),
      linear-gradient(0deg, rgba(59, 40, 25, .55) 0%, rgba(59, 40, 25, 0) 45%); }
  .hero[data-align='right'] .hero__shade--left { opacity: 0; }
  .hero[data-align='right'] .hero__shade--right { opacity: 1; }
  .hero__content { position: absolute; left: 0; right: 0; bottom: 0; max-width: var(--container-max); margin: 0 auto;
    padding: 0 var(--gutter) clamp(72px, 9vh, 104px); display: flex; flex-direction: column; gap: 16px; }
  .hero__content > * { max-width: 600px; }
  .hero__content { transition: opacity .45s var(--ease-soft); align-items: flex-start; }
  .hero.is-moving .hero__content { opacity: 0; }
  .hero[data-align='right'] .hero__content { align-items: flex-end; text-align: right; }
  .hero[data-align='right'] .hero__actions { justify-content: flex-end; }
  /* Small text over a changing photo: a translucent espresso pill keeps it readable on every slide. */
  .hero__eyebrow { display: inline-flex; padding: 7px 16px; border-radius: var(--radius-pill);
    background: rgba(59, 40, 25, .78); backdrop-filter: blur(4px); font-size: 12px; font-weight: 500;
    letter-spacing: .32em; text-transform: uppercase; color: var(--rh-ivory); }
  /* Wider than the rest of the text, but capped so a long phrase wraps instead of running across a face. */
  .hero__content > .hero__scripts { display: grid; max-width: 640px; align-items: end; }
  .hero__script { grid-area: 1 / 1; font-family: var(--font-script); font-size: clamp(50px, 7vw, 96px); text-wrap: balance;
    line-height: 1; color: var(--rh-caramel-soft); opacity: 0; transition: opacity var(--dur-slow) var(--ease-soft);
    text-shadow: 0 2px 16px rgba(59, 40, 25, .7); }
  .hero__script[data-active='true'] { opacity: 1; }
  .hero__title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.15; text-wrap: balance; text-shadow: 0 1px 18px rgba(59, 40, 25, .45); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }
  .hero__dots { position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%); display: none; }
  .hero.has-slides .hero__dots { display: flex; }
  .hero__dots button { min-width: 24px; height: 24px; padding: 0; border: 0; background: transparent; cursor: pointer; display: grid; place-items: center; }
  .hero__dots button::before { content: ''; width: 10px; height: 10px; border-radius: 999px; background: var(--rh-ivory-30); transition: width var(--dur-base) var(--ease-soft), background var(--dur-base) var(--ease-soft); }
  .hero__dots button[data-active='true']::before { width: 36px; background: var(--rh-sand); }

  .steps { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 28px; }
  .step { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  /* The label sits half on the photo and half below it. */
  .step__photo { position: relative; align-self: stretch; margin-bottom: 36px; }
  /* `transform`, not `translate`: the scroll reveal animates `translate` on this element. */
  .step__tab { position: absolute; left: 50%; bottom: 0; transform: translate(-50%, 50%); max-width: 92%; box-sizing: border-box; display: flex; align-items: baseline; gap: 12px;
    padding: 14px 26px; border-radius: var(--radius-pill); background: var(--rh-ivory); box-shadow: var(--shadow-soft); white-space: nowrap; }
  .step__n { font-family: var(--font-display); font-size: 18px; line-height: 1; color: var(--rh-terracotta); }
  .step__title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(18px, 1.7vw, 22px); line-height: 1.2; color: var(--text-strong); }
  .step__text { margin: 0 0 2px; max-width: 30ch; color: var(--text-muted); }

  .split { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .split--flip { grid-template-columns: 1.1fr 1fr; }
  .split__text { display: flex; flex-direction: column; gap: 28px; align-items: flex-start; }
  .split__photo { max-width: 560px; width: 100%; justify-self: center; }
  .split--flip .split__photo { justify-self: end; } /* on the content edge, in line with the sections around it */
  .specialties { list-style: none; margin: 48px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px 20px; }
  .sp__link { display: flex; flex-direction: column; gap: 14px; text-decoration: none; color: var(--text-strong); }
  .sp__photo { border-radius: var(--radius-lg); }
  .sp__label { font-family: var(--font-display); font-size: 21px; line-height: 1.2; }
  .sp__link:hover .sp__label { color: var(--text-accent); }
  .sp__cta { height: 100%; min-height: 220px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; gap: 8px;
    padding: 28px; border-radius: var(--radius-lg); background: var(--surface-terracotta); color: var(--rh-ivory); text-decoration: none;
    transition: background var(--dur-base) var(--ease-soft); }
  .sp__cta:hover { background: var(--rh-chocolate); color: var(--rh-ivory); }
  .sp__cta-script { font-family: var(--font-script); font-size: var(--fs-script-s); line-height: 1; color: var(--rh-caramel-soft); }
  .sp__cta-title { font-family: var(--font-display); font-size: 28px; line-height: 1.15; }
  .sp__cta-text { font-size: 15px; color: var(--text-on-dark-muted); }

  .letters { max-width: 860px; margin: 48px auto 0; text-align: center; }
  .letter + .letter { margin-top: 48px; }
  .letter :global(.review) { align-items: center; gap: 22px; }
  .letter :global(.review__quote) { font-size: clamp(22px, 2.5vw, 32px); line-height: 1.45; text-wrap: balance; }
  .letter :global(.review__by) { align-items: center; }
  .letters__nav { display: none; }
  /* With JavaScript the letters share one spot (as tall as the longest), and only the current one shows. */
