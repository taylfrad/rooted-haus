---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import { ChevronDown } from '@lucide/astro';

const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="FAQ · The Rooted Haus" description="Answers to common questions about visiting The Rooted Haus.">
  <PageHeader eyebrow="FAQ" script="good to know" title="Questions, answered" bg="var(--surface-chocolate)" />
  <Section bg="var(--surface-raised)">
    <div class="faq">
      {faqs.map((f) => (
        <details class="item">
          <summary>
            <span>{f.data.question}</span>
            <ChevronDown size={20} stroke-width={1.5} class="chev" />
          </summary>
          <p>{f.data.answer}</p>
        </details>
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .faq { max-width: var(--container-narrow); }
  .item { border-top: 1px solid var(--border-hairline); }
  .item:last-child { border-bottom: 1px solid var(--border-hairline); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 24px 0; cursor: pointer; font-family: var(--font-display); font-size: 22px; color: var(--text-strong); }
  summary::-webkit-details-marker { display: none; }
  summary :global(.chev) { flex-shrink: 0; transition: transform var(--dur-base) var(--ease-soft); }
  details[open] summary :global(.chev) { transform: rotate(180deg); }
  p { margin: 0 0 24px; max-width: 60ch; }
</style>
