---
import headerPhoto from '../assets/photos/rituals/img-0041.jpg';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import BookButton from '../components/core/BookButton.astro';
import { url } from '../lib/paths';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Meet the Haus · The Rooted Haus" description="Our mission and the stylists of The Rooted Haus, a holistic hair studio in Mandeville, Louisiana, rooted in wellness and centered by faith.">
  <PageHeader
    eyebrow="Meet the Haus"
    script="our roots"
    title="The hands and hearts of our foundation"
    intro="Just as every living thing depends on its roots to grow and flourish, The Rooted Haus also depends on ours. Meet the hands and hearts of our foundation who help nurture and grow our Haus, bringing our vision of beauty and wellness to life."
    bg="var(--surface-olive)"
    image={headerPhoto}
    imageAlt="Stylists at work with clients across the salon floor."
    focus="50% 40%"
  />
  <Section>
    <div class="mission">
      <span class="mission__label">Our roots · our mission</span>
      <p class="mission__text">
        We help natural minded women nurture their low-tox dream lifestyles by offering personalized hair care services
        rooted in wellness and centered by faith while making each guest feel like they have stepped into an extension of their home.
      </p>
    </div>
  </Section>
  <Section bg="var(--surface-sage)">
    <ul class="team">
      {team.map((m) => (
        <li>
          <a class="member" href={url(`team/${m.id}/`)}>
            <div class="member__photo">
              <PhotoFrame shape="circle" focus={m.data.photoFocus} src={m.data.photo} alt={`${m.data.name}, ${m.data.role}`} label={m.data.name} sizes="240px" />
            </div>
            <span class="member__name">{m.data.name}</span>
            <span class="member__role">{m.data.role}</span>
            {m.data.experience && <span class="member__exp">{m.data.experience}</span>}
            <span class="member__more">Read {m.data.name}’s story</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="cta"><BookButton>Book with us</BookButton></div>
  </Section>
</BaseLayout>

<style>
  .mission { max-width: 860px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .mission__label { font-size: 12px; font-weight: 500; letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--text-accent); }
  .mission__text { margin: 0; font-family: var(--font-display); font-size: clamp(24px, 3vw, 34px); line-height: 1.4; color: var(--text-strong); text-wrap: balance; }
  .team { list-style: none; margin: 0 0 56px; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 56px 40px; }
  .member { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; color: var(--rh-espresso); text-decoration: none; }
  .member__photo { width: min(240px, 100%); margin-bottom: 14px; border-radius: 50%;
    transition: transform var(--dur-base) var(--ease-soft), box-shadow var(--dur-base) var(--ease-soft); }
  .member:hover .member__photo { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .member__name { font-family: var(--font-display); font-size: 30px; line-height: 1.1; }
  .member__role { font-size: 12px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; }
  .member__exp { font-size: 15px; }
  .member__more { margin-top: 6px; font-size: 12px; font-weight: 500; letter-spacing: var(--ls-button); text-transform: uppercase;
    text-decoration: underline; text-underline-offset: 6px; text-decoration-color: transparent; transition: text-decoration-color var(--dur-base); }
  .member:hover .member__more { text-decoration-color: currentColor; }
  .member:hover { color: var(--rh-espresso); }
  .cta { display: flex; justify-content: center; }
  @media (max-width: 900px) { .team { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .team { grid-template-columns: 1fr; } }
</style>
