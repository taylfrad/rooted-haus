---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/content/SectionHeading.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import Badge from '../components/content/Badge.astro';
import BookButton from '../components/core/BookButton.astro';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="About & team · The Rooted Haus" description="Meet the stylists behind The Rooted Haus.">
  <PageHeader eyebrow="About the studio" script="wellness, beauty, community" title="More than hair" intro="The Rooted Haus is a holistic hair studio where scalp and hair health come first. We take our time, and we choose what goes on your head with care." bg="var(--surface-olive)" />
  <Section bg="var(--surface-sage)">
    <SectionHeading tone="sage" eyebrow="Meet the team" title="The people behind the chairs" />
    <div class="team">
      {team.map((m) => (
        <article class="member" data-reveal>
          <div class="member__photo"><PhotoFrame shape="circle" label={m.data.name} /></div>
          <h3 class="member__name">{m.data.name}</h3>
          <p class="member__role">{m.data.role}</p>
          <p class="member__bio">{m.data.bio}</p>
          <div class="member__tags">{m.data.specialties.map((s) => <Badge tone="ivory">{s}</Badge>)}</div>
        </article>
      ))}
    </div>
    <div class="cta"><BookButton variant="primary">Book with us</BookButton></div>
  </Section>
</BaseLayout>

<style>
  .team { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 48px; margin: 56px 0; }
  .member { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; color: var(--rh-espresso); }
  .member__photo { width: min(220px, 100%); margin-bottom: 12px; }
  .member__name { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 28px; }
  .member__role { margin: 0; font-size: 12px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; }
  .member__bio { margin: 8px 0; max-width: 34ch; }
  .member__tags { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .cta { display: flex; justify-content: center; }
</style>
