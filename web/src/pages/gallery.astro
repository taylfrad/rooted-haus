---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import BookButton from '../components/core/BookButton.astro';
import { site } from '../lib/site';

const items = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const tags = ['all', ...new Set(items.map((i) => i.data.tag))];

// A circle only works in a square cell, so on wide or tall cells it becomes a rounded frame instead.
type Shape = 'arch' | 'circle' | 'rounded' | 'soft';
const shapeFor = (shape: Shape, size: string): Shape => (shape === 'circle' && (size === 'wide' || size === 'tall') ? 'rounded' : shape);
// Image width hints: a cell spanning two columns needs a bigger file than a single one.
const sizesFor = (size: string) => (size === 'wide' || size === 'large' ? '(min-width: 1200px) 600px, 100vw' : '(min-width: 1200px) 300px, 50vw');
---

<BaseLayout title="Gallery · The Rooted Haus" description="Recent work from The Rooted Haus.">
  <PageHeader eyebrow="Gallery" script="our work" title="Recent work" intro="Healthy hair, finished with care." bg="var(--surface-chocolate)" />
  <Section>
    <div class="filters" role="group" aria-label="Filter gallery">
      {tags.map((t, i) => <button type="button" class="chip" data-filter={t} aria-pressed={i === 0}>{t}</button>)}
    </div>
    <div class="mosaic-wrap">
      <div class="mosaic">
        {items.map((i) => (
          <div class={`tile tile--${i.data.size}`} data-tag={i.data.tag}>
            <PhotoFrame
              fill
              shape={shapeFor(i.data.shape, i.data.size)}
              label={i.data.label}
              src={i.data.image}
              alt={i.data.alt ?? i.data.label}
              sizes={sizesFor(i.data.size)}
            />
          </div>
        ))}
      </div>
    </div>
    <div class="cta">
      <BookButton>Book an appointment</BookButton>
      <a href={site.instagram} target="_blank" rel="noopener">Follow us on Instagram</a>
    </div>
  </Section>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cells = [...document.querySelectorAll<HTMLElement>('[data-tag]')];
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        cells.forEach((cell) => (cell.hidden = f !== 'all' && cell.dataset.tag !== f));
      }),
    );
  });
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 40px; }
  .chip { font: inherit; font-size: 12px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase;
    border: 1px solid var(--rh-chocolate); background: transparent; color: var(--rh-chocolate); cursor: pointer;
    border-radius: var(--radius-pill); padding: 9px 20px;
    transition: background var(--dur-base) var(--ease-soft), color var(--dur-base) var(--ease-soft); }
  .chip:hover, .chip[aria-pressed='true'] { background: var(--rh-chocolate); color: var(--rh-ivory); }

  /* Mosaic: every cell is a square whose side is worked out from the grid's width, so wide, tall and large
     photos (spanning 2 cells) line up exactly with the small ones. `dense` lets small photos fill any gaps. */
  .mosaic-wrap { --cols: 4; --gap: 16px; container-type: inline-size; } /* cqw below measures this wrapper, not the grid itself */
  .mosaic { display: grid; gap: var(--gap); grid-auto-flow: dense;
    grid-template-columns: repeat(var(--cols), 1fr);
    grid-auto-rows: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols)); }
  .tile--wide { grid-column: span 2; }
  .tile--tall { grid-row: span 2; }
  .tile--large { grid-column: span 2; grid-row: span 2; }
  .tile[hidden] { display: none; }
  @media (max-width: 900px) { .mosaic-wrap { --cols: 3; } }
  @media (max-width: 560px) { .mosaic-wrap { --cols: 2; --gap: 12px; } }

  .cta { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 56px; }
</style>
