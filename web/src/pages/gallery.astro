---
import headerPhoto from '../assets/photos/hero/img-0086.jpg';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import BookButton from '../components/core/BookButton.astro';
import { site } from '../lib/site';

const items = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
const tags = ['all', ...new Set(items.map((i) => i.data.tag))];

// A larger copy of each photo for the lightbox (and for the plain link when JavaScript is off).
// Every gallery photo is a square or rectangle (gently rounded corners); only the size varies.
const tiles = await Promise.all(
  items.map(async (entry) => {
    const img = entry.data.image;
    const full = img ? await getImage({ src: img, width: Math.min(1800, img.width), format: 'webp', quality: 80 }) : undefined;
    return {
      entry,
      alt: entry.data.alt ?? entry.data.label,
      full: full && { src: full.src, width: Number(full.attributes.width), height: Number(full.attributes.height) },
    };
  }),
);

// Image width hints: a cell spanning two columns needs a bigger file than a single one.
const sizesFor = (size: string) => (size === 'wide' || size === 'large' ? '(min-width: 1200px) 600px, 100vw' : '(min-width: 1200px) 300px, 50vw');
---

<BaseLayout title="Gallery · The Rooted Haus" description="Recent work from The Rooted Haus.">
  <PageHeader eyebrow="Gallery" script="our work" title="Recent work" intro="Healthy hair, finished with care." bg="var(--surface-chocolate)" image={headerPhoto} imageAlt="A guest rests under a stone eye mask while a scalp treatment is brushed on." focus="35% 45%" />
  <Section>
    <div class="filters" role="group" aria-label="Filter gallery">
      {tags.map((t, i) => <button type="button" class="chip" data-filter={t} aria-pressed={i === 0}>{t}</button>)}
    </div>
    <div class="mosaic-wrap">
      <div class="mosaic">
        {tiles.map(({ entry: i, alt, full }) => {
          const frame = (
            <PhotoFrame fill shape="soft" label={i.data.label} src={i.data.image} alt={alt} sizes={sizesFor(i.data.size)} />
          );
          return (
            <div class={`tile tile--${i.data.size}`} data-tag={i.data.tag}>
              {full ? (
                <a class="tile__link" href={full.src} data-pswp-width={full.width} data-pswp-height={full.height} aria-label={`View larger: ${alt}`}>
                  {frame}
                </a>
              ) : (
                frame
              )}
            </div>
          );
        })}
      </div>
    </div>
    <div class="cta">
      <BookButton>Book an appointment</BookButton>
      <a href={site.instagram} target="_blank" rel="noopener">Follow us on Instagram</a>
    </div>
  </Section>
</BaseLayout>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  let lightbox: PhotoSwipeLightbox | undefined;

  document.addEventListener('astro:page-load', () => {
    // Lightbox: rebuilt on each visit to the page, and only over the photos the current filter shows.
    lightbox?.destroy();
    lightbox = undefined;
    if (document.querySelector('.mosaic')) {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      lightbox = new PhotoSwipeLightbox({
        gallery: '.mosaic',
        children: '.tile:not([hidden]) .tile__link',
        pswpModule: () => import('photoswipe'),
        showHideAnimationType: reduce ? 'none' : 'fade',
        bgOpacity: 0.97,
        padding: { top: 32, bottom: 72, left: 16, right: 16 },
      });
      // Caption: the photo's description, under the photo.
      lightbox.on('uiRegister', () => {
        lightbox!.pswp!.ui!.registerElement({
          name: 'caption',
          order: 9,
          isButton: false,
          appendTo: 'root',
          onInit: (el, pswp) => {
            pswp.on('change', () => {
              el.textContent = pswp.currSlide?.data.element?.querySelector('img')?.alt ?? '';
            });
          },
        });
      });
      lightbox.init();
    }

    const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cells = [...document.querySelectorAll<HTMLElement>('[data-tag]')];
    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        cells.forEach((cell) => (cell.hidden = f !== 'all' && cell.dataset.tag !== f));
      }),
    );
  });
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 40px; }
  .chip { font: inherit; font-size: 12px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase;
    border: 1px solid var(--rh-chocolate); background: transparent; color: var(--rh-chocolate); cursor: pointer;
    border-radius: var(--radius-pill); padding: 9px 20px;
    transition: background var(--dur-base) var(--ease-soft), color var(--dur-base) var(--ease-soft); }
  .chip:hover, .chip[aria-pressed='true'] { background: var(--rh-chocolate); color: var(--rh-ivory); }

  /* Mosaic: every cell is a square whose side is worked out from the grid's width, so wide, tall and large
     photos (spanning 2 cells) line up exactly with the small ones. `dense` lets small photos fill any gaps. */
  .mosaic-wrap { --cols: 4; --gap: 16px; container-type: inline-size; } /* cqw below measures this wrapper, not the grid itself */
  .mosaic { display: grid; gap: var(--gap); grid-auto-flow: dense;
    grid-template-columns: repeat(var(--cols), 1fr);
    grid-auto-rows: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols)); }
  .tile--wide { grid-column: span 2; }
  .tile--tall { grid-row: span 2; }
  .tile--large { grid-column: span 2; grid-row: span 2; }
  .tile[hidden] { display: none; }
  .tile__link { display: block; height: 100%; cursor: zoom-in;
    transition: transform var(--dur-base) var(--ease-soft), filter var(--dur-base) var(--ease-soft); }
  .tile__link:hover { transform: translateY(-4px); filter: drop-shadow(0 18px 24px rgba(59, 40, 25, .28)); }
  /* Tablets use 2 columns too: with 2-cell-wide and 2-cell-tall photos, 3 columns cannot pack without holes. */
  @media (max-width: 900px) { .mosaic-wrap { --cols: 2; } }
  @media (max-width: 560px) { .mosaic-wrap { --cols: 2; --gap: 12px; } }

  .cta { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 56px; }
</style>

<style is:global>
  /* PhotoSwipe in the brand colors */
  .pswp { --pswp-bg: var(--rh-espresso); --pswp-icon-color: var(--rh-ivory); --pswp-icon-color-secondary: var(--rh-espresso); --pswp-icon-stroke-color: var(--rh-espresso); }
  .pswp__caption { position: absolute; left: 0; right: 0; bottom: 20px; padding: 0 24px; text-align: center;
    font-family: var(--font-sans); font-size: 14px; line-height: 1.5; color: var(--rh-ivory); pointer-events: none; }
</style>
