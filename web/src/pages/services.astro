---
import headerPhoto from '../assets/photos/rituals/img-9963.jpg';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import DealBanner from '../components/DealBanner.astro';
import BookButton from '../components/core/BookButton.astro';
import Button from '../components/core/Button.astro';
import { site } from '../lib/site';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import photoCut from '../assets/photos/rituals/img-0046.jpg';
import photoColor from '../assets/photos/rituals/img-0127.jpg';
import photoScalp from '../assets/photos/rituals/img-0098.jpg';

const photos = [
  { src: photoCut, alt: 'A stylist in a newsboy cap curls a client’s long blonde hair.', shape: 'arch' },
  { src: photoColor, alt: 'A stylist checks the blend of a client’s soft blonde balayage.', shape: 'rounded' },
  { src: photoScalp, alt: 'A client relaxes under a stone eye mask while a scalp treatment is brushed on.', shape: 'arch' },
] as const;

const categories = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="The Rituals: services & prices · The Rooted Haus" description="Haircuts, blonding, dimensional color, grey blending, scalp services and extensions at The Rooted Haus in Mandeville, Louisiana.">
  <PageHeader eyebrow="Services & prices" script="the rituals" title="Our rituals" intro="Personalized hair care, rooted in wellness." image={headerPhoto} imageAlt="Color mixed by hand in a bowl at the station." focus="45% 50%" />
  <DealBanner />
  <Section bg="var(--surface-raised)">
    <div class="layout">
    <div class="menu-col">
    <nav class="jump" aria-label="Service categories">
      {categories.map((c) => <a href={`#${c.id}`}>{c.data.title}</a>)}
    </nav>
    {categories.map((c) => (
      <div class="cat" id={c.id}>
        <h2 class="cat__title">{c.data.title}</h2>
        {c.data.blurb && <p class="cat__blurb">{c.data.blurb}</p>}
        <ul class="menu">
          {c.data.items.map((item) => (
            <li class="menu__row" data-reveal>
              <div>
                <h3 class="menu__name">{item.name}</h3>
                {item.description && <p class="menu__desc">{item.description}</p>}
              </div>
              <div class="menu__meta">
                {item.price && <span class="menu__price">{item.price}</span>}
                {item.duration && <span class="menu__dur">{item.duration}</span>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
    </div>
    <div class="photo-col">
      {photos.map((p) => <PhotoFrame src={p.src} alt={p.alt} shape={p.shape} ratio="4 / 5" sizes="(min-width: 900px) 30vw, 33vw" />)}
    </div>
    </div>
    <div class="cta">
      <BookButton size="lg">Book an appointment</BookButton>
      {site.giftCardsUrl && <Button variant="outline" size="lg" href={site.giftCardsUrl} target="_blank" rel="noopener">Give a gift card</Button>}
    </div>
  </Section>
</BaseLayout>

<style>
  .layout { display: grid; grid-template-columns: 1fr minmax(240px, 0.55fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .menu-col { min-width: 0; }
  .photo-col { display: flex; flex-direction: column; gap: 24px; position: sticky; top: 110px; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } .photo-col { position: static; flex-direction: row; order: -1; } .photo-col > :global(*) { flex: 1; } }
  .jump { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 56px; }
  .jump a { border: 1px solid var(--rh-chocolate); border-radius: var(--radius-pill); padding: 10px 22px;
    color: var(--rh-chocolate); text-decoration: none; font-size: 12px; font-weight: 500; letter-spacing: .18em;
    text-transform: uppercase; transition: background var(--dur-base) var(--ease-soft), color var(--dur-base) var(--ease-soft); }
  .jump a:hover { background: var(--rh-chocolate); color: var(--rh-ivory); }
  .cat { margin-bottom: 64px; scroll-margin-top: 100px; max-width: var(--container-narrow); }
  .cat__title { margin: 0 0 8px; font-family: var(--font-display); font-weight: 400; font-size: var(--fs-display-m); color: var(--text-strong); }
  .cat__blurb { margin: 0 0 24px; color: var(--text-muted); }
  .menu { list-style: none; margin: 0; padding: 0; }
  .menu__row { display: flex; justify-content: space-between; gap: 24px; padding: 22px 0;
    border-top: 1px solid var(--border-hairline); }
  .menu__row:last-child { border-bottom: 1px solid var(--border-hairline); }
  .menu__name { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 22px; color: var(--text-strong); }
  .menu__desc { margin: 6px 0 0; font-size: 15px; color: var(--text-muted); }
  .menu__meta { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; white-space: nowrap; }
  .menu__price { font-family: var(--font-display); font-size: 20px; color: var(--text-strong); }
  .menu__dur { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); }
  .cta { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 14px; }
</style>
