---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import DealBanner from '../components/DealBanner.astro';
import BookButton from '../components/core/BookButton.astro';
import Button from '../components/core/Button.astro';
import { site } from '../lib/site';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import { getPage } from '../lib/pages';

// Header and side photos come from "The Rituals page" in the panel; the menu itself from "Services & prices".
const page = await getPage('ritualsPage');
// Shapes alternate down the column (arch, rounded, arch...) however many photos there are.
const photos = page.photos.map((p, i) => ({ ...p, shape: i % 2 === 0 ? ('arch' as const) : ('rounded' as const) }));

const categories = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <PageHeader {...page.header} />
  <DealBanner />
  <Section bg="var(--surface-raised)">
    <div class="layout">
    <div class="menu-col">
    <nav class="jump" aria-label="Service categories">
      {categories.map((c) => <a class="pill" href={`#${c.id}`}>{c.data.title}</a>)}
    </nav>
    {categories.map((c) => (
      <div class="cat" id={c.id}>
        <h2 class="title-m cat__title">{c.data.title}</h2>
        {c.data.blurb && <p class="cat__blurb">{c.data.blurb}</p>}
        <ul class="menu">
          {c.data.items.map((item) => (
            <li class="menu__row" data-reveal>
              <div>
                <h3 class="menu__name">{item.name}</h3>
                {item.description && <p class="menu__desc">{item.description}</p>}
              </div>
              <div class="menu__meta">
                {item.price && <span class="menu__price">{item.price}</span>}
                {item.duration && <span class="menu__dur">{item.duration}</span>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
    </div>
    <!-- The photos run the full height of the menu beside them, sharing it evenly, so both columns start and end
         together and scroll as one. Adding photos in the panel makes each one shorter. -->
    <div class="photo-col" style={`--photos:${Math.max(photos.length, 1)}`}>
      {photos.map((p) => <PhotoFrame framed="light" fill src={p.image} alt={p.alt} focus={p.focus} shape={p.shape} sizes="(min-width: 900px) 30vw, 33vw" />)}
    </div>
    </div>
    <div class="cta">
      <BookButton size="lg">{page.buttons.book}</BookButton>
      {site.giftCardsUrl && <Button variant="outline" size="lg" href={site.giftCardsUrl} target="_blank" rel="noopener">{page.buttons.gift}</Button>}
    </div>
  </Section>
</BaseLayout>

<style>
  .layout { display: grid; grid-template-columns: 1fr minmax(240px, 0.55fr); gap: clamp(32px, 6vw, 96px); align-items: stretch; }
  .menu-col { min-width: 0; }
  /* contain: size stops the photos from adding height of their own: the column takes the menu's height, then splits it. */
  .photo-col { display: grid; grid-template-rows: repeat(var(--photos), minmax(0, 1fr)); gap: 28px; contain: size; }
  .cat:last-child { margin-bottom: 0; } /* so the menu's last line and the last photo end level */
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .photo-col { contain: none; display: flex; flex-direction: row; gap: 16px; order: -1; }
    .photo-col > :global(.pf) { flex: 1; height: auto; aspect-ratio: 4 / 5; }
    .cat:last-child { margin-bottom: 64px; }
  }
  .jump { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 56px; }
  .cat { margin-bottom: 64px; scroll-margin-top: 100px; max-width: var(--container-narrow); }
  .cat__title { margin-bottom: 8px; }
  .cat__blurb { margin: 0 0 24px; color: var(--text-muted); }
  .menu { list-style: none; margin: 0; padding: 0; }
  .menu__row { display: flex; justify-content: space-between; gap: 24px; padding: 22px 0;
    border-top: 1px solid var(--border-hairline); }
  .menu__row:last-child { border-bottom: 1px solid var(--border-hairline); }
  .menu__name { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 22px; line-height: var(--lh-snug); color: var(--text-strong); }
  .menu__desc { margin: 6px 0 0; font-size: 15px; color: var(--text-muted); }
  .menu__meta { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; white-space: nowrap; }
  .menu__price { font-family: var(--font-display); font-size: 20px; color: var(--text-strong); }
  .menu__dur { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); }
  .cta { margin-top: 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
</style>
