---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import DirectionsMap from '../components/DirectionsMap.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import Field from '../components/forms/Field.astro';
import BookButton from '../components/core/BookButton.astro';
import Button from '../components/core/Button.astro';
import SectionHeading from '../components/content/SectionHeading.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import PhotoPair from '../components/content/PhotoPair.astro';
import { MapPin, Clock, Phone, ChevronDown } from '@lucide/astro';
import { url } from '../lib/paths';
import { maps, site } from '../lib/site';
import { getPage } from '../lib/pages';

const page = await getPage('connectPage');
const tel = `tel:${site.phone.replace(/[^\d+]/g, '')}`;

// FAQ lives here (no separate page). The section only appears once there are questions in the panel.
const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

// "Step inside": the first four studio photos from the Gallery, skipping any already shown higher on this page.
const shown = new Set([page.header.image?.src, page.expect?.image?.src, page.expect?.image2?.src]);
const studio = (await getCollection('gallery'))
  .sort((a, b) => a.data.order - b.data.order)
  .filter((g) => g.data.tag === 'studio' && g.data.image && !shown.has(g.data.image.src))
  .slice(0, 4);
---

<BaseLayout title={page.seo.title} description={page.seo.description}>
  <PageHeader {...page.header} />

  <Section>
    <!-- The three things people come here for, side by side; then the map, wide, beneath them. -->
    <ul class="ways">
      <li class="way">
        <span class="ic"><MapPin size={20} stroke-width={1.5} /></span>
        <h2 class="way__label">{page.labels.find}</h2>
        <p class="way__main">{site.address.line1}<br />{site.address.city}</p>
        <a class="way__link caps-link" href={maps.google} target="_blank" rel="noopener" data-directions-open aria-haspopup="dialog">{page.labels.directions}</a>
      </li>
      <li class="way">
        <span class="ic"><Clock size={20} stroke-width={1.5} /></span>
        <h2 class="way__label">{page.labels.hours}</h2>
        <dl class="hours">
          {site.hours.map((h) => (
            <div class="hours__row">
              <dt>{h.days}</dt>
              {h.time && <dd>{h.time}</dd>}
            </div>
          ))}
        </dl>
      </li>
      <li class="way">
        <span class="ic"><Phone size={20} stroke-width={1.5} /></span>
        <h2 class="way__label">{page.labels.call}</h2>
        <a class="way__main way__phone" href={tel}>{site.phone}</a>
        <div class="way__action"><BookButton>{site.bookLabel}</BookButton></div>
      </li>
    </ul>
    <div class="map"><DirectionsMap /></div>
  </Section>

  {page.expect && (
    <Section bg="var(--surface-sand)">
      <div class="split">
        <div class="split__photo">
          <PhotoPair src={page.expect.image} alt={page.expect.alt} focus={page.expect.focus} src2={page.expect.image2} alt2={page.expect.alt2} focus2={page.expect.focus2} ring="var(--surface-sand)" side="end" />
        </div>
        <div class="split__text">
          <SectionHeading align="left" eyebrow={page.expect.eyebrow} script={page.expect.script} title={page.expect.title} intro={page.expect.text} />
          <div class="split__actions">
            <Button variant="outline" href={url('experience/')}>{page.expect.experienceButton}</Button>
            <Button variant="text" href={url('team/')}>{page.expect.teamButton}</Button>
          </div>
        </div>
      </div>
    </Section>
  )}

  {/* The message form and newsletter signup appear once a form address is set in the panel (docs/forms.md). */}
  {site.formsReady && (
  <Section bg="var(--surface-raised)">
    <div class="message" id="message">
      <div>
        <h2 class="title-m h">{page.message.title}</h2>
        {page.message.text && <p class="lead">{page.message.text}</p>}
      </div>
      <ContactForm subject="Website message">
        <Field label="Name" name="name" required />
        <Field label="Email" name="email" type="email" required />
        <Field label="Message" name="message" type="textarea" required />
      </ContactForm>
    </div>
  </Section>
  )}

  {faqs.length > 0 && (
    <Section>
      <div class="faq" id="faq">
        <h2 class="title-m h">{page.labels.faq}</h2>
        {faqs.map((f) => (
          <details class="faq__item">
            <summary>
              <span>{f.data.question}</span>
              <ChevronDown size={20} stroke-width={1.5} class="chev" />
            </summary>
            <p>{f.data.answer}</p>
          </details>
        ))}
      </div>
    </Section>
  )}

  {site.formsReady && (
  <Section bg="var(--surface-sand)" center>
    <div class="news" id="newsletter">
      <h2 class="title-m h">{page.newsletter.title}</h2>
      {page.newsletter.text && <p>{page.newsletter.text}</p>}
      <ContactForm subject="Newsletter signup" submitLabel="Join the list">
        <Field label="Email" name="email" type="email" required />
      </ContactForm>
    </div>
  </Section>
  )}

  {page.inside && studio.length > 0 && (
    <Section bg="var(--surface-raised)">
      <div class="inside__head">
        <SectionHeading align="left" eyebrow={page.inside.eyebrow} script={page.inside.script} title={page.inside.title} />
        <div class="inside__actions">
          {site.instagram && (
            <a class="caps-link inside__ig" href={site.instagram} target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" fill="currentColor" /></svg>{page.inside.instagramButton}</a>
          )}
          <Button variant="outline" href={url('gallery/')}>{page.inside.galleryButton}</Button>
        </div>
      </div>
      <div class="inside__grid">
        {studio.map((g) => <PhotoFrame src={g.data.image} alt={g.data.alt ?? g.data.label} label={g.data.label} shape="soft" ratio="3 / 4" sizes="(min-width: 900px) 25vw, 50vw" />)}
      </div>
    </Section>
  )}

  {page.closing && (
    <Section bg="var(--surface-olive)" center curve>
        <div class="closing">
          {page.closing.script && <span class="closing__script">{page.closing.script}</span>}
          <p class="closing__line">{page.closing.text}</p>
          <BookButton variant="ivory" size="lg">{site.bookLabel}</BookButton>
        </div>
    </Section>
  )}
</BaseLayout>

<style>
  .ways { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .way { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; padding: 36px 32px; border-radius: var(--radius-lg); background: var(--surface-sand); }
  .ic { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--rh-ivory); color: var(--rh-terracotta); }
  .way__label { margin: 4px 0 0; font-family: var(--font-sans); font-size: 12px; font-weight: 500; letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--text-accent); }
  .way__main { margin: 0; font-family: var(--font-display); font-size: var(--fs-title); line-height: 1.35; color: var(--text-strong); }
  .way__phone { font-size: var(--fs-display-s); text-decoration: none; font-variant-numeric: tabular-nums; }
  .way__phone:hover { color: var(--text-accent); }
  /* The link and the button sit on the bottom edge of their cards, so the three cards end on one line. */
  .way__link, .way__action { margin-top: auto; }
  .way__link { color: var(--rh-chocolate); }
  .hours { margin: 0; align-self: stretch; display: flex; flex-direction: column; }
  .hours__row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--border-hairline); font-size: 15px; }
  .hours__row:first-child { border-top: 1px solid var(--border-hairline); }
  .hours dd { margin: 0; color: var(--text-strong); font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* A wide, shallow map: it shows the surrounding streets without pushing the rest of the page down. */
  .map { margin-top: 24px; }
  .map :global(.dm) { aspect-ratio: 21 / 8; min-height: 320px; }

  /* Your first visit: photos on the outer edge, words beside them, as on the home page. */
  .split { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .split__photo { max-width: 520px; width: 100%; }
  .split__text { display: flex; flex-direction: column; gap: 28px; align-items: flex-start; }
  .split__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  /* Step inside: the same heading row and photo row as "Recent work" on the home page. */
  .inside__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 36px; flex-wrap: wrap; }
  .inside__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; }
  .inside__ig { display: inline-flex; align-items: center; gap: 8px; color: var(--rh-chocolate); }
  .inside__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

  .h { margin-bottom: 16px; }
  .lead { margin: 0; color: var(--text-muted); }
  .message { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq { max-width: var(--container-narrow); }
  .faq__item { border-top: 1px solid var(--border-hairline); }
  .faq__item:last-child { border-bottom: 1px solid var(--border-hairline); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 22px 0; cursor: pointer; font-family: var(--font-display); font-size: 22px; color: var(--text-strong); }
  summary::-webkit-details-marker { display: none; }
  summary :global(.chev) { flex-shrink: 0; transition: transform var(--dur-base) var(--ease-soft); }
  details[open] summary :global(.chev) { transform: rotate(180deg); }
  .faq__item p { margin: 0 0 22px; max-width: 60ch; }
  .news { max-width: 480px; margin: 0 auto; text-align: left; }
  .news .h, .news p { text-align: center; }

  .closing { max-width: 680px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .closing__script { font-family: var(--font-script); font-size: var(--fs-script-s); line-height: 1.1; color: var(--rh-caramel-soft); }
  .closing__line { margin: 0 0 8px; font-family: var(--font-display); font-size: clamp(24px, 2.8vw, 34px); line-height: 1.35; color: var(--rh-ivory); text-wrap: balance; }

  @media (max-width: 900px) {
    .ways, .message, .split { grid-template-columns: 1fr; }
    .split__photo { justify-self: center; }
    .inside__grid { grid-template-columns: repeat(2, 1fr); }
    .map :global(.dm) { aspect-ratio: auto; }
  }
</style>
