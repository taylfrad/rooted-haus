---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import PhotoFrame from '../components/content/PhotoFrame.astro';
import SectionHeading from '../components/content/SectionHeading.astro';
import Button from '../components/core/Button.astro';
import { url } from '../lib/paths';
import salonPhoto from '../assets/photos/rituals/img-0041.jpg';
---

<BaseLayout title="Our Roots · The Rooted Haus" description="The mission of The Rooted Haus: personalized hair care rooted in wellness and centered by faith, in Mandeville, Louisiana.">
  <PageHeader eyebrow="Our Roots" script="wellness, beauty, faith" title="Rooted in wellness, centered by faith" bg="var(--surface-olive)" />

  <Section>
    <div class="mission">
      <span class="mission__label">Our mission</span>
      <p class="mission__text">
        We help natural minded women nurture their low-tox dream lifestyles by offering personalized hair care services
        rooted in wellness and centered by faith while making each guest feel like they have stepped into an extension of their home.
      </p>
    </div>
  </Section>

  <Section bg="var(--surface-raised)">
    <div class="split">
      <div class="split__photo">
        <PhotoFrame src={salonPhoto} alt="Stylists at work with clients across the salon floor." shape="arch" ratio="4 / 5" sizes="(min-width: 900px) 38vw, 90vw" />
      </div>
      <div class="split__text">
        <SectionHeading align="left" eyebrow="Get to know us" title="The people and the place" intro="Meet the stylists who make up our Haus, and see what a visit with us feels like." />
        <div class="links">
          <Button href={url('team/')}>Meet the Haus</Button>
          <Button variant="outline" href={url('experience/')}>The Experience</Button>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .mission { max-width: 860px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 20px; }
  .mission__label { font-size: 12px; font-weight: 500; letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--text-accent); }
  .mission__text { margin: 0; font-family: var(--font-display); font-size: clamp(24px, 3vw, 36px); line-height: 1.4; color: var(--text-strong); text-wrap: balance; }
  .split { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .split__photo { max-width: 440px; width: 100%; justify-self: center; }
  .split__text { display: flex; flex-direction: column; gap: 28px; align-items: flex-start; }
  .links { display: flex; flex-wrap: wrap; gap: 14px; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
</style>
