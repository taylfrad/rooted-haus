---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../layouts/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import ReviewCard from '../components/content/ReviewCard.astro';
import BookButton from '../components/core/BookButton.astro';
import { url } from '../lib/paths';

const reviews = await getCollection('reviews');
const team = await getCollection('team');
const stylist = (slug?: string) => team.find((t) => t.id === slug);
---

<BaseLayout title="Love letters · The Rooted Haus" description="Success stories and kind words from the guests of The Rooted Haus.">
  <PageHeader eyebrow="Success stories" script="love letters" title="From our clients" bg="var(--surface-olive)" />
  <Section>
    <div class="grid">
      {reviews.map((r) => {
        const s = stylist(r.data.stylist);
        return (
          <div class="item" data-reveal>
            <ReviewCard quote={r.data.quote} name={r.data.name} detail={s ? `with ${s.data.name}` : r.data.detail} rating={r.data.rating} />
            {s && <a class="item__link" href={url(`team/${s.id}/`)}>Meet {s.data.name}</a>}
          </div>
        );
      })}
    </div>
    <div class="cta"><BookButton>Book an appointment</BookButton></div>
  </Section>
</BaseLayout>

<style>
  .grid { columns: 2; column-gap: 64px; }
  .item { break-inside: avoid; margin-bottom: 56px; display: flex; flex-direction: column; gap: 12px; }
  .item__link { font-size: 12px; font-weight: 500; letter-spacing: var(--ls-button); text-transform: uppercase; color: var(--rh-chocolate); }
  .cta { margin-top: 8px; }
  @media (max-width: 800px) { .grid { columns: 1; } }
</style>
