---
interface Props {
  bg?: string;
  center?: boolean;
  id?: string;
  /** The top edge rises in a wide, shallow arch over the section above, instead of meeting it in a straight line. */
  curve?: boolean;
}
const { bg = 'var(--surface-page)', center = false, id, curve = false } = Astro.props;
---

<section id={id} style={`background-color:${bg}`} class:list={['section', { 'section--center': center, 'section--curve': curve, 'on-olive': bg.includes('olive') }]}>
  <div class="section__inner" data-reveal><slot /></div>
</section>

<style>
  /* background-color (not the shorthand) is set inline, so the paper grain below is kept on every section. */
  .section { padding: var(--section-y) var(--gutter); background-image: var(--grain); }
  .section--center { text-align: center; }
  .section__inner { max-width: var(--container-max); margin: 0 auto; }

  /* The arch is a cap in the section's own color and grain, sitting in the bottom padding of the section above.
     (Without the grain it would be a shade lighter than the section it belongs to.) */
  .section--curve { position: relative; }
  .section--curve::before { content: ''; position: absolute; left: 0; right: 0; bottom: calc(100% - 1px); height: var(--curve);
    background-color: inherit; background-image: var(--grain); border-radius: 50% 50% 0 0 / 100% 100% 0 0; pointer-events: none; }
</style>
