---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { isStaging, url } from '../lib/paths';
import { site } from '../lib/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DirectionsDialog from '../components/DirectionsDialog.astro';
import BackToTop from '../components/BackToTop.astro';
// The three font files every page uses (Latin letters). Preloading them means text is drawn in its real font from
// the first paint, instead of appearing in a fallback and shifting when the font arrives.
import fontBody from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import fontDisplay from '@fontsource/gilda-display/files/gilda-display-latin-400-normal.woff2?url';
import fontScript from '@fontsource/la-belle-aurore/files/la-belle-aurore-latin-400-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Always hide this page from search engines (used by dev-only pages). */
  noindex?: boolean;
}

const {
  title = 'The Rooted Haus · Holistic Hair Studio',
  description = 'A holistic hair studio in Mandeville, Louisiana, where scalp and hair health come first.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('og.png'), Astro.site).href;
const ogImageAlt = `${site.name}, ${site.tagline}: come as you are`;

// Business listing data for search engines. Skips social links that are still placeholders.
const place = site.address.city.match(/^(.*?),\s*([A-Z]{2})\s+(\d{5})/);
const realSocial = [site.instagram, site.facebook].filter((u) => new URL(u).pathname.length > 1);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: site.name,
  description,
  url: new URL(url(), Astro.site).href,
  image: ogImage,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: place ? place[1] : site.address.city,
    addressRegion: place?.[2],
    postalCode: place?.[3],
    addressCountry: 'US',
  },
  ...(realSocial.length > 0 && { sameAs: realSocial }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F2E4D1" />
    <link rel="canonical" href={canonical} />
    {[fontBody, fontDisplay, fontScript].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    {(isStaging || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href={url('favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={url('favicon-16x16.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />
    <meta name="apple-mobile-web-app-title" content="Rooted Haus" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Scripts on each page re-run after a page transition via the astro:page-load event. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // Page transitions swap <html> attributes; put the class back.
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <!-- No transition:name here: the page change fades the whole page (styles/global.css), so nothing slides. -->
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <DirectionsDialog />
    <BackToTop />
    <!-- Boulevard self-booking overlay, from the owner's Boulevard dashboard (Settings > Online booking >
         Self-booking overlay). Loads once; the guard stops it loading again when Astro swaps pages. -->
    <script is:inline>
      (function (a) {
        if (window.blvd) return;
        var b = { businessId: '14e32701-917e-48b8-b878-37f7b2c5b8c5' };
        var c = a.createElement('script');
        var d = a.querySelector('script');
        c.src = 'https://static.joinboulevard.com/injector.min.js';
        c.async = true;
        c.onload = function () { blvd.init(b); };
        d.parentNode.insertBefore(c, d);
      })(document);
    </script>
    <script>
      import { initHeadlines, initPhotoFade, initReveal } from '../lib/motion';
      import { initFit } from '../lib/fit';
      // Every booking button (BookButton, data-book) opens Boulevard's overlay on top of the site once the overlay is
      // ready (its .blvd-dialog is on the page). Until then, if the script is blocked, and on phones (where Boulevard
      // opens booking in a new tab instead of an overlay) the button stays a normal link to the Boulevard booking page.
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest('[data-book]');
        const blvd = (window as { blvd?: { openBookingWidget?: (o?: object) => void } }).blvd;
        if (!btn || typeof blvd?.openBookingWidget !== 'function' || !document.querySelector('.blvd-dialog')) return;
        e.preventDefault();
        blvd.openBookingWidget();
      });

      // Boulevard builds its overlay once, on the first page: a <style> in <head> and the dialog at the end of <body>.
      // Pages then change without a reload (Astro's ClientRouter), which rebuilds <head> and <body> from the next page
      // and would drop both, leaving the dialog unstyled at the bottom of the page and the buttons doing nothing.
      // Marking them, with a matching empty placeholder in the incoming page, makes the router carry them over.
      document.addEventListener('astro:before-swap', (e) => {
        const next = (e as Event & { newDocument: Document }).newDocument;
        const keep = (el: Element, id: string, into: Element) => {
          el.setAttribute('data-astro-transition-persist', id);
          const spot = next.createElement(el.tagName);
          spot.setAttribute('data-astro-transition-persist', id);
          into.append(spot);
        };
        document.querySelectorAll('head style').forEach((s, i) => {
          if (s.textContent?.includes('.blvd-')) keep(s, `blvd-style-${i}`, next.head);
        });
        const dialog = document.querySelector('.blvd-dialog');
        if (dialog) keep(dialog, 'blvd-dialog', next.body);
      });

      document.addEventListener('astro:page-load', () => {
        initPhotoFade();
        initFit();
        initHeadlines();
        initReveal();
      });

      // Every new page starts at the top. A clicked footer link keeps focus (the footer is kept between pages), and
      // Astro refocuses it after the swap, which scrolls the new page down to the footer. Drop focus first, as a
      // normal page load would.
      document.addEventListener('astro:before-preparation', () => (document.activeElement as HTMLElement | null)?.blur?.());

      // Links to a spot on the same page (the category buttons on The Rituals, the skip link) glide there instead of
      // jumping. Only these links: smooth scrolling for the whole document would also animate Back and Forward.
      // Runs before Astro's own link handling (capture), which then leaves the click alone.
      document.addEventListener(
        'click',
        (e) => {
          const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
          if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
          if (!target) return;
          e.preventDefault();
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          // Keyboard and screen-reader users continue from the target (the skip link lands on <main>).
          if (target.tabIndex >= 0 || target.hasAttribute('tabindex')) target.focus({ preventScroll: true });
          history.replaceState(history.state, '', link.hash);
        },
        { capture: true },
      );
    </script>
  </body>
</html>
