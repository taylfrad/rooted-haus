---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { isStaging, url } from '../lib/paths';
import { site } from '../lib/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DirectionsDialog from '../components/DirectionsDialog.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  /** Always hide this page from search engines (used by dev-only pages). */
  noindex?: boolean;
}

const {
  title = 'The Rooted Haus · Holistic Hair Studio',
  description = 'A holistic hair studio in Mandeville, Louisiana, where scalp and hair health come first.',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url('og.png'), Astro.site).href;
const ogImageAlt = `${site.name}, ${site.tagline}: come as you are`;

// Business listing data for search engines. Skips social links that are still placeholders.
const place = site.address.city.match(/^(.*?),\s*([A-Z]{2})\s+(\d{5})/);
const realSocial = [site.instagram, site.facebook].filter((u) => new URL(u).pathname.length > 1);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: site.name,
  description,
  url: new URL(url(), Astro.site).href,
  image: ogImage,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.line1,
    addressLocality: place ? place[1] : site.address.city,
    addressRegion: place?.[2],
    postalCode: place?.[3],
    addressCountry: 'US',
  },
  ...(realSocial.length > 0 && { sameAs: realSocial }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F3ECE2" />
    <link rel="canonical" href={canonical} />
    {(isStaging || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href={url('favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('favicon-32x32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={url('favicon-16x16.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="manifest" href={url('site.webmanifest')} />
    <meta name="apple-mobile-web-app-title" content="Rooted Haus" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Scripts on each page re-run after a page transition via the astro:page-load event. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // Page transitions swap <html> attributes; put the class back.
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <!-- No transition:name here: the page change fades the whole page (styles/global.css), so nothing slides. -->
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter />
    <DirectionsDialog />
    <BackToTop />
    <!-- TODO: add the Boulevard self-booking overlay <script> here once the snippet is copied from
         the owner's Boulevard dashboard (Settings > Online booking > Self-booking overlay). -->
    <script>
      import { initReveal } from '../lib/motion';
      document.addEventListener('astro:page-load', initReveal);

      // Every new page starts at the top. A clicked footer link keeps focus (the footer is kept between pages), and
      // Astro refocuses it after the swap, which scrolls the new page down to the footer. Drop focus first, as a
      // normal page load would.
      document.addEventListener('astro:before-preparation', () => (document.activeElement as HTMLElement | null)?.blur?.());

      // Links to a spot on the same page (the category buttons on The Rituals, the skip link) glide there instead of
      // jumping. Only these links: smooth scrolling for the whole document would also animate Back and Forward.
      // Runs before Astro's own link handling (capture), which then leaves the click alone.
      document.addEventListener(
        'click',
        (e) => {
          const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
          if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
          if (!target) return;
          e.preventDefault();
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          // Keyboard and screen-reader users continue from the target (the skip link lands on <main>).
          if (target.tabIndex >= 0 || target.hasAttribute('tabindex')) target.focus({ preventScroll: true });
          history.replaceState(history.state, '', link.hash);
        },
        { capture: true },
      );
    </script>
  </body>
</html>
