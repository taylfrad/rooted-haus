---
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  options?: string[];
  required?: boolean;
  placeholder?: string;
}
const { label, name, type = 'text', options = [], required = false, placeholder } = Astro.props;
const id = `f-${name}`;
---

<div class="field">
  <label for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
  {type === 'textarea' && <textarea id={id} name={name} rows="5" required={required} placeholder={placeholder} />}
  {type === 'select' && (
    <select id={id} name={name} required={required}>
      <option value="" disabled selected>Choose one</option>
      {options.map((o) => <option value={o}>{o}</option>)}
    </select>
  )}
  {type !== 'textarea' && type !== 'select' && <input id={id} name={name} type={type} required={required} placeholder={placeholder} />}
</div>

<style>
  .field { display: flex; flex-direction: column; gap: 8px; }
  label { font-size: 12px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; color: var(--text-strong); }
  input, select, textarea { font: inherit; font-size: 16px; color: var(--text-strong); background: var(--surface-raised);
    border: 1px solid var(--border-hairline); padding: 14px 22px; box-sizing: border-box; width: 100%;
    border-radius: var(--radius-pill); transition: border-color var(--dur-base) var(--ease-soft); }
  textarea { border-radius: var(--radius-lg); resize: vertical; }
  input:hover, select:hover, textarea:hover { border-color: var(--rh-chocolate-50); }
  input:focus-visible, select:focus-visible, textarea:focus-visible { border-color: var(--focus-ring); }
</style>
