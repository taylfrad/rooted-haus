---
import type { ImageMetadata } from 'astro';
import SectionHeading from './content/SectionHeading.astro';
import PhotoFrame from './content/PhotoFrame.astro';
import WidePhoto from './content/WidePhoto.astro';
import Watermark from './Watermark.astro';
import { cropPosition } from '../lib/crop';

interface Props {
  eyebrow: string;
  script?: string;
  title: string;
  intro?: string;
  bg?: string;
  /** Put a landscape photo beside the heading, still whole, instead of across the screen. */
  beside?: boolean;
  /** A landscape photo runs across the screen, never taller than the first screen, with the heading set over a lower
      corner (on phones the heading sits in a band below it instead); a portrait one sits whole beside the heading. */
  image?: ImageMetadata;
  alt?: string;
  /** Which lower corner of a landscape photo the heading sits in. */
  side?: 'left' | 'right';
  /** Which part of a landscape photo to keep when the first screen is shorter than the photo (CSS object-position). */
  focus?: string;
}
const { eyebrow, script, title, intro, bg = 'var(--surface-terracotta)', image, alt = '', beside = false, side: textSide = 'left', focus } = Astro.props;
const landscape = !!image && image.width >= image.height;
const wide = landscape && !beside;
const side = !!image && !wide;
const position = cropPosition(focus);
// The photo's own height as a share of its width: the header is never taller than the whole photo.
const photoVars = wide ? `;--ph-ratio:${(image.height / image.width).toFixed(4)}${position ? `;--ph-focus:${position}` : ''}` : '';
---

<header class:list={['ph', { 'on-olive': bg.includes('olive'), 'ph--side': side, 'ph--beside': landscape && beside, 'ph--over': wide, 'ph--right': wide && textSide === 'right' }]} style={`background:${bg}${photoVars}`}>
  {wide && <WidePhoto src={image} {alt} eager />}
  <div class="ph__band">
  <!-- data-reveal: on arrival the heading rises in like the scroll reveals; the photo stays still (photos never animate). -->
  <div class="ph__inner" data-reveal>
    <div class="ph__text">
      <Watermark align={side ? 'left' : 'center'} />
      <SectionHeading as="h1" tone="dark" align={side ? 'left' : 'center'} {eyebrow} {script} {title} {intro} />
    </div>
    {side && (
      <div class="ph__photo">
        <PhotoFrame eager src={image} {alt} framed="dark" shape="rounded" ratio={`${image.width} / ${image.height}`} sizes={landscape ? '(min-width: 900px) 55vw, 90vw' : '(min-width: 900px) 480px, 90vw'} />
      </div>
    )}
  </div>
  </div>
</header>

<style>
  .ph__band { position: relative; overflow: hidden; padding: clamp(56px, 8vw, 104px) var(--gutter); }
  .ph__inner { position: relative; z-index: 1; max-width: var(--container-max); margin: 0 auto; }
  .ph--side .ph__band { padding-top: clamp(48px, 6vw, 80px); padding-bottom: clamp(48px, 6vw, 80px); }
  .ph--side .ph__inner { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .ph__photo { width: 100%; max-width: 480px; justify-self: end; }
  .ph--beside .ph__inner { grid-template-columns: 1fr 1.25fr; }
  .ph--beside .ph__photo { max-width: none; }
  @media (max-width: 900px) {
    .ph--side .ph__inner, .ph--beside .ph__inner { grid-template-columns: 1fr; }
    .ph__photo { max-width: none; justify-self: stretch; }
  }

  /* Wide screens, landscape photo: the header is exactly the first screen (or the whole photo, if that is shorter), so
     scrolling goes straight to the page and never to more photo. When the screen is shorter than the photo, the photo
     is cropped around its focus point. The heading is set over a lower corner on a soft espresso shade, as on the home
     page. Narrower screens keep the band below the photo, where the photo is too short to hold the words. */
  @media (min-width: 1000px) {
    .ph--over { --header-h: 73px; position: relative; overflow: hidden;
      height: min(100svh - var(--header-h), 100vw * var(--ph-ratio)); min-height: 440px; }
    .ph--over :global(img.wide) { height: 100%; object-fit: cover; object-position: var(--ph-focus, 50% 50%); }
    .ph--over .ph__band { position: absolute; inset: 0; box-sizing: border-box;
      z-index: 1; display: flex; align-items: flex-end; padding: 0 var(--gutter) clamp(36px, 6vh, 64px); }
    /* The shade runs the full height of the photo down the side the words are on. */
    .ph--over::after { content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(var(--ph-shade-to, 90deg), rgba(59, 40, 25, .86) 0%, rgba(59, 40, 25, .68) 28%, rgba(59, 40, 25, .28) 50%, rgba(59, 40, 25, 0) 68%); }
    .ph--over .ph__inner { width: 100%; display: flex; }
    .ph--over .ph__text { max-width: 720px; text-shadow: 0 1px 18px rgba(59, 40, 25, .45); }
    /* The heading and monogram are centered in the band; over the photo they line up on the left. */
    .ph--over .ph__text :global(.sh) { align-items: flex-start; text-align: left; gap: 16px; }
    .ph--over .ph__text :global(.sh__rule:first-child) { display: none; }
    .ph--over .ph__text :global(.wm) { height: clamp(96px, 14vh, 136px); margin-left: 0; margin-bottom: var(--space-4); opacity: .85; }
    /* Larger words than a section heading: this is the first thing on the page. Sized by the screen's width and
       height together, so they still fit a short window. */
    .ph--over .ph__text :global(.sh__eyebrow) { font-size: 14px; }
    .ph--over .ph__text :global(.sh__script) { font-size: clamp(56px, min(6vw, 10vh), var(--fs-script-l)); }
    .ph--over .ph__text :global(.sh__title) { font-size: clamp(44px, min(5.2vw, 9vh), 80px); }
    .ph--over .ph__text :global(.sh__intro) { font-size: clamp(18px, 1.5vw, 22px); color: var(--rh-ivory); }

    /* Words in the lower right corner: everything lines up on the right edge and the shade comes from the right. */
    .ph--right { --ph-shade-to: 270deg; }
    .ph--right .ph__inner { justify-content: flex-end; }
    .ph--right .ph__text :global(.sh) { align-items: flex-end; text-align: right; }
    .ph--right .ph__text :global(.sh__eyebrow) { flex-direction: row-reverse; }
    .ph--right .ph__text :global(.sh__rule:last-child) { margin-left: 0; margin-right: 16px; }
    .ph--right .ph__text :global(.sh__label) { margin-right: 0; margin-left: calc(-1 * var(--ls-eyebrow)); }
    .ph--right .ph__text :global(.wm) { margin-left: auto; margin-right: 0; }
  }
</style>
