---
import { Navigation, X } from '@lucide/astro';
import Button from './core/Button.astro';
import { maps, site } from '../lib/site';
---

<div class="dm">
  <div class="dm__map">
    <!-- Decorative: the link below names the place and opens the chooser; pointer events are off so a tap never pans the map. -->
    <iframe
      src={maps.embed}
      title={`Map showing ${site.name}`}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      tabindex="-1"
      aria-hidden="true"></iframe>
    <a class="dm__open" href={maps.google} target="_blank" rel="noopener" data-directions-open aria-haspopup="dialog">
      <span class="dm__hint"><Navigation size={16} stroke-width={1.5} /> Get directions</span>
      <span class="sr-only">to {site.name}, {maps.address}. Choose Apple Maps or Google Maps.</span>
    </a>
  </div>

  <dialog class="dm__dialog" id="directions-dialog" aria-labelledby="dm-title">
    <button class="dm__close" type="button" aria-label="Close" data-directions-close><X size={20} stroke-width={1.5} /></button>
    <h2 class="dm__title" id="dm-title">Get directions</h2>
    <p class="dm__addr">{site.name}<br />{site.address.line1}<br />{site.address.city}</p>
    <div class="dm__choices">
      <Button href={maps.apple} target="_blank" rel="noopener" data-map="apple" fullWidth>Apple Maps</Button>
      <Button href={maps.google} target="_blank" rel="noopener" data-map="google" fullWidth>Google Maps</Button>
    </div>
    <p class="dm__note">Your maps app opens with the route to us already filled in.</p>
  </dialog>
</div>

<script>
  // Delegated on document so it survives page transitions.
  const dialog = () => document.getElementById('directions-dialog') as HTMLDialogElement | null;
  const onApple = () => /iPhone|iPad|iPod|Macintosh/.test(navigator.userAgent);

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (target.closest('[data-directions-open]')) {
      const d = dialog();
      if (!d || typeof d.showModal !== 'function') return; // no dialog support: the link goes straight to Google Maps
      e.preventDefault();
      d.dataset.pref = onApple() ? 'apple' : 'google';
      d.showModal();
    } else if (target.closest('[data-directions-close]')) {
      dialog()?.close();
    } else if (target === dialog()) {
      dialog()?.close(); // click on the backdrop
    }
  });
</script>

<style>
  .dm__map { position: relative; aspect-ratio: 16 / 11; min-height: 300px; border-radius: var(--radius-lg); overflow: hidden;
    background: var(--rh-sand); box-shadow: var(--shadow-soft); transition: box-shadow var(--dur-base) var(--ease-soft), transform var(--dur-base) var(--ease-soft); }
  .dm__map:hover { box-shadow: var(--shadow-lift); transform: translateY(-4px); }
  /* On narrow screens a fixed height replaces the ratio: ratio + min-height would force the map wider than the screen. */
  @media (max-width: 900px) { .dm__map { aspect-ratio: auto; height: 340px; min-height: 0; } }
  /* Oversized and centered so Google's own info card and zoom controls fall outside the clipped frame;
     the pin stays in the middle because the map centers inside the iframe. */
  iframe { position: absolute; width: 160%; height: 190%; left: -30%; top: -45%; border: 0; pointer-events: none; filter: var(--photo-warmth); }
  .dm__open { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: center; padding: 24px;
    border-radius: var(--radius-lg); text-decoration: none; }
  .dm__hint { display: inline-flex; align-items: center; gap: 10px; padding: 14px 26px; border-radius: var(--radius-pill);
    background: var(--rh-terracotta); color: var(--rh-ivory); font-size: 12px; font-weight: 500; letter-spacing: var(--ls-button);
    text-transform: uppercase; box-shadow: var(--shadow-soft); transition: background var(--dur-base) var(--ease-soft); }
  .dm__open:hover .dm__hint { background: var(--rh-chocolate); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .dm__dialog { border: 0; padding: 36px 32px 28px; border-radius: var(--radius-lg); background: var(--surface-raised); color: var(--text-body);
    width: min(440px, calc(100vw - 40px)); box-shadow: var(--shadow-lift); }
  .dm__dialog::backdrop { background: rgba(59, 40, 25, .45); backdrop-filter: blur(6px); }
  .dm__close { position: absolute; top: 12px; right: 12px; width: 40px; height: 40px; display: grid; place-items: center;
    border: 0; border-radius: 50%; background: transparent; color: var(--rh-chocolate); cursor: pointer; }
  .dm__close:hover { background: var(--rh-sand); }
  .dm__title { margin: 0 0 12px; font-family: var(--font-display); font-weight: 400; font-size: var(--fs-display-s); color: var(--text-strong); }
  .dm__addr { margin: 0 0 24px; }
  .dm__choices { display: flex; flex-direction: column; gap: 12px; }
  /* the viewer's likely maps app goes first */
  .dm__dialog[data-pref='apple'] [data-map='apple'] { order: -1; }
  .dm__dialog[data-pref='google'] [data-map='google'] { order: -1; }
  .dm__note { margin: 16px 0 0; font-size: 14px; color: var(--text-muted); }
</style>
