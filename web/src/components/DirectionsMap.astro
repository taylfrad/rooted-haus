---
import { Navigation } from '@lucide/astro';
import { maps, site } from '../lib/site';

interface Props {
  /** Smaller map for the footer. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={['dm', { 'dm--compact': compact }]}>
  <!-- Decorative: the link below names the place and opens the chooser (DirectionsDialog); pointer events are off so a tap never pans the map. -->
  <iframe
    data-src={maps.embed}
    title={`Map showing ${site.name}`}
    referrerpolicy="no-referrer-when-downgrade"
    tabindex="-1"
    aria-hidden="true"></iframe>
  <a class="dm__open" href={maps.google} target="_blank" rel="noopener" data-directions-open aria-haspopup="dialog">
    <span class="dm__hint"><Navigation size={compact ? 14 : 16} stroke-width={1.5} /> Get directions</span>
    <span class="sr-only">to {site.name}, {maps.address}. Choose Apple Maps or Google Maps.</span>
  </a>
</div>

<script>
  // Google's embed is heavy, so it never competes with the page: each map starts loading only once the page has
  // finished loading, the browser is idle, and the map is within 400px of the screen. The footer map is
  // kept between pages (transition:persist), so it loads once per visit.
  function loadMaps() {
    // data-observed: the persisted footer map outlives page changes, so never watch the same frame twice.
    const frames = document.querySelectorAll<HTMLIFrameElement>('iframe[data-src]:not([data-observed])');
    if (frames.length === 0) return;
    const whenIdle = (fn: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 3000 }) : setTimeout(fn, 1500);
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          whenIdle(() => {
            const f = e.target as HTMLIFrameElement;
            const src = f.dataset.src;
            if (!src) return; // already started
            f.removeAttribute('data-src');
            f.src = src;
          });
        }),
      { rootMargin: '400px' },
    );
    frames.forEach((f) => {
      f.setAttribute('data-observed', '');
      io.observe(f);
    });
  }
  document.addEventListener('astro:page-load', () => {
    if (document.readyState === 'complete') loadMaps();
    else window.addEventListener('load', loadMaps, { once: true });
  });
</script>

<style>
  .dm { position: relative; aspect-ratio: 16 / 11; min-height: 300px; border-radius: var(--radius-lg); overflow: hidden;
    background: var(--rh-sand); box-shadow: var(--shadow-soft); transition: box-shadow var(--dur-base) var(--ease-soft), transform var(--dur-base) var(--ease-soft); }
  .dm:hover { box-shadow: var(--shadow-lift); transform: translateY(-4px); }
  /* On narrow screens a fixed height replaces the ratio: ratio + min-height would force the map wider than the screen. */
  @media (max-width: 900px) { .dm { aspect-ratio: auto; height: 340px; min-height: 0; } }

  /* The iframe is pushed up so Google's own address card (top-left) is clipped away. The bottom edge stays in view
     so Google's logo and map-data attribution remain visible, as their terms ask. */
  iframe { position: absolute; left: 0; top: -120px; width: 100%; height: calc(100% + 120px); border: 0; pointer-events: none; filter: var(--photo-warmth); }
  .dm__open { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: center; padding: 24px 24px 34px;
    border-radius: var(--radius-lg); text-decoration: none; }
  .dm__hint { display: inline-flex; align-items: center; gap: 10px; padding: 14px 26px; border-radius: var(--radius-pill);
    background: var(--rh-terracotta); color: var(--rh-ivory); font-size: 12px; font-weight: 500; letter-spacing: var(--ls-button);
    text-transform: uppercase; box-shadow: var(--shadow-soft); transition: background var(--dur-base) var(--ease-soft); }
  .dm__open:hover .dm__hint { background: var(--rh-chocolate); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* footer size */
  .dm--compact { aspect-ratio: auto; height: 210px; min-height: 0; border-radius: var(--radius-md); box-shadow: none; }
  .dm--compact:hover { transform: none; box-shadow: none; }
  .dm--compact iframe { top: -125px; height: calc(100% + 125px); }
  .dm--compact .dm__open { padding: 12px 12px 40px; border-radius: var(--radius-md); }
  .dm--compact .dm__hint { padding: 9px 18px; gap: 8px; font-size: 10.5px; }
</style>
