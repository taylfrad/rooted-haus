---
import { Image } from 'astro:assets';
import { Menu, X } from '@lucide/astro';
import logo from '../assets/logo-wordmark-chocolate.png';
import logoIvory from '../assets/logo-wordmark-ivory.png';
import BookButton from './core/BookButton.astro';
import { nav, site } from '../lib/site';
import { url } from '../lib/paths';

const path = Astro.url.pathname;
// Home only: the header starts see-through over the hero photo (ivory logo and links) and turns solid on scroll.
const overlay = path === url();
---

<!-- Its own layer in page changes, so it stays put while the page beneath fades (styles/global.css). "initial" keeps
     the browser's crossfade, which blends identical pixels seamlessly; only Home's see-through header visibly changes. -->
<header class:list={['header', { 'header--overlay': overlay }]} transition:name="site-header" transition:animate="initial">
  <div class="header__inner">
    <a href={url()} class="header__logo" aria-label={`${site.name} — ${site.tagline}`}>
      <Image src={logo} alt={`${site.name} — ${site.tagline}`} height={88} densities={[1, 2]} class="logo--dark" />
      {overlay && <Image src={logoIvory} alt="" aria-hidden="true" height={88} densities={[1, 2]} class="logo--light" />}
    </a>
    <nav class="header__nav" aria-label="Main">
      <ul class="header__links" id="site-menu">
        {nav.map((item) => (
          <li>
            <a href={url(item.href)} aria-current={path === url(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
      <BookButton size="sm">{site.bookLabel}</BookButton>
      <button class="header__toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-menu">
        <span class="icon-open"><Menu size={20} stroke-width={1.5} /></span>
        <span class="icon-close"><X size={20} stroke-width={1.5} /></span>
      </button>
    </nav>
  </div>
</header>

<script>
  // Delegated on document so it survives page transitions (the header is re-rendered each time).
  document.addEventListener('click', (e) => {
    const toggle = (e.target as Element).closest<HTMLButtonElement>('.header__toggle');
    if (!toggle) return;
    const open = toggle.closest('.header')?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  // At the very top of a page the logo is shown larger; once the page scrolls it eases down to its working size.
  // Home also turns its see-through header solid at the same moment.
  const syncHeader = () => {
    const h = document.querySelector('.header');
    if (!h) return;
    const scrolled = window.scrollY > 24;
    if (scrolled === h.classList.contains('is-scrolled')) return;
    h.classList.toggle('is-scrolled', scrolled);
    if (h.classList.contains('header--overlay')) h.classList.toggle('is-solid', scrolled);
  };
  window.addEventListener('scroll', syncHeader, { passive: true });
  document.addEventListener('astro:page-load', syncHeader);
</script>

<style>
  /* Nearly solid, with no backdrop blur: a blurred sticky bar is redrawn on every frame of scrolling. */
  .header { position: sticky; top: 0; z-index: 20; background: rgba(242, 228, 209, .97);
    border-bottom: 1px solid var(--border-hairline); }
  .header__inner { max-width: var(--container-max); margin: 0 auto; padding: 14px var(--gutter); display: flex;
    align-items: center; justify-content: space-between; gap: 24px; }
  .header__logo { display: flex; flex-shrink: 0; } /* the logo never shrinks; the menu collapses first */
  /* The size change is a scale, not a height: the header bar keeps its height, so nothing below it moves, and the
     browser can animate it without re-laying out the page. The larger logo fits inside the bar's own padding. */
  .header__logo :global(img) { height: 44px; width: auto; max-width: 100%; object-fit: contain;
    transform: scale(var(--logo-scale, 1.42)); transform-origin: left center; transition: transform var(--dur-base) var(--ease-glide); }
  .header.is-scrolled .header__logo :global(img), .header.is-open .header__logo :global(img) { transform: none; }
  .header__nav { display: flex; align-items: center; gap: 20px; }
  .header__links { display: flex; gap: 20px; margin: 0; padding: 0; list-style: none; }
  .header__links a { color: var(--rh-chocolate); text-decoration: none; white-space: nowrap; font-size: 12px;
    font-weight: 500; letter-spacing: .13em; text-transform: uppercase; padding-bottom: 4px;
    border-bottom: 1px solid transparent; }
  .header__links a:hover, .header__links a[aria-current='page'] { border-bottom-color: var(--rh-terracotta); }
  .header__toggle { display: none; width: 40px; height: 40px; border: 0; background: transparent;
    color: var(--rh-chocolate); border-radius: var(--radius-pill); cursor: pointer; place-items: center; }
  .icon-close { display: none; }
  .is-open .icon-open { display: none; }
  .is-open .icon-close { display: inline; }

  /* --- Home: see-through over the hero until scrolled (or the menu is opened) --- */
  .logo--light { display: none; }
  .header--overlay { position: fixed; left: 0; right: 0; transition: background var(--dur-base) var(--ease-soft), border-color var(--dur-base) var(--ease-soft); }
  .header--overlay:not(.is-solid):not(.is-open) { background: transparent; border-bottom-color: transparent; }
  .header--overlay:not(.is-solid):not(.is-open) :global(.logo--dark) { display: none; }
  .header--overlay:not(.is-solid):not(.is-open) :global(.logo--light) { display: block; }
  .header--overlay:not(.is-solid):not(.is-open) .header__toggle { color: var(--rh-ivory); }
  @media (min-width: 1100px) {
    .header--overlay:not(.is-solid):not(.is-open) .header__links a { color: var(--rh-ivory); text-shadow: 0 1px 8px rgba(59, 40, 25, .6); }
    .header--overlay:not(.is-solid):not(.is-open) .header__links a:hover { border-bottom-color: var(--rh-sand); }
  }

  /* Five menu items need about 1100px; below that the menu moves behind the toggle. */
  @media (max-width: 1099px) {
    .header__logo { flex-shrink: 1; min-width: 0; } /* with the menu collapsed, the logo may shrink a little on very narrow phones */
    .header__logo :global(img) { height: 36px; --logo-scale: 1.3; }
    .header__nav { gap: 12px; }
    .header__toggle { display: grid; }
    .header__links { display: none; position: absolute; left: 0; right: 0; top: 100%; flex-direction: column;
      gap: 18px; padding: 20px var(--gutter) 28px; background: var(--surface-page);
      border-top: 1px solid var(--border-hairline); border-bottom: 1px solid var(--border-hairline); }
    .is-open .header__links { display: flex; }
  }
  /* Phones: a more compact booking button leaves the logo room to stay readable. */
  @media (max-width: 560px) {
    .header__nav { gap: 6px; }
    .header__nav :global(.btn) { padding: 9px 13px; letter-spacing: .1em; }
    .header__logo :global(img) { --logo-scale: 1; } /* no room to grow: the booking button and menu take the rest of the row */
  }
</style>
