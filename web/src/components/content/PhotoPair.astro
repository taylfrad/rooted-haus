---
// Two photos as one composition: a large arched one, and a smaller one overlapping its lower corner.
// With only one photo it is simply that photo, framed.
import type { ImageMetadata } from 'astro';
import PhotoFrame from './PhotoFrame.astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  focus?: string;
  /** The smaller photo that overlaps the corner (optional). */
  src2?: ImageMetadata;
  alt2?: string;
  focus2?: string;
  /** Which lower corner the smaller photo sits on. */
  side?: 'start' | 'end';
  /** Shape of the large photo and of the smaller one. Keep them different. */
  shape?: 'arch' | 'rounded';
  shape2?: 'arch' | 'rounded' | 'circle';
  /** The fine line around the large photo: light sections or dark ones. */
  framed?: 'light' | 'dark';
  /** The color of the section behind, used for the gap around the smaller photo. */
  ring?: string;
  label?: string;
}
const { src, alt = '', focus, src2, alt2 = '', focus2, side = 'start', shape = 'arch', shape2 = 'rounded', framed = 'light', ring = 'var(--surface-page)', label } = Astro.props;
---

<div class:list={['pair', `pair--${side}`, { 'pair--single': !src2 }]} style={`--pair-ring:${ring}`}>
  <div class="pair__main">
    <PhotoFrame {framed} {src} {alt} {focus} {label} {shape} ratio="4 / 5" sizes="(min-width: 900px) 36vw, 80vw" />
  </div>
  {src2 && (
    <div class:list={['pair__second', `pair__second--${shape2}`]}>
      <PhotoFrame src={src2} alt={alt2} focus={focus2} shape={shape2} ratio="4 / 5" sizes="(min-width: 900px) 20vw, 42vw" />
    </div>
  )}
</div>

<style>
  .pair { position: relative; padding-bottom: 14%; }
  .pair__main { width: 80%; margin-left: auto; }
  /* The gap around the smaller photo is a band in the section's own color and grain, so it matches the section
     exactly and reads as cut out of the large photo. */
  .pair__second { position: absolute; left: 0; bottom: 0; width: 44%; box-sizing: border-box; padding: 10px;
    border-radius: calc(var(--radius-lg) + 10px); background-color: var(--pair-ring); background-image: var(--grain); }
  .pair__second--arch { border-radius: var(--radius-arch); }
  .pair__second--circle { border-radius: 50%; }
  .pair--end .pair__main { margin-left: 0; margin-right: auto; }
  .pair--end .pair__second { left: auto; right: 0; }
  .pair--single { padding-bottom: 0; }
  .pair--single .pair__main { width: 100%; }
</style>
