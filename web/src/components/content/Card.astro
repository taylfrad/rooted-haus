---
interface Props {
  surface?: 'ivory' | 'sand' | 'sage' | 'olive' | 'terracotta' | 'espresso';
  eyebrow?: string;
  title?: string;
  price?: string;
  interactive?: boolean;
}
const { surface = 'ivory', eyebrow, title, price, interactive = false } = Astro.props;
---

<div class:list={['card', `card--${surface}`, { 'card--interactive': interactive }]}>
  <slot name="media" />
  <div class="card__body">
    {eyebrow && <span class="card__eyebrow">{eyebrow}</span>}
    {(title || price) && (
      <div class="card__head">
        {title && <h3 class="card__title">{title}</h3>}
        {price && <span class="card__price">{price}</span>}
      </div>
    )}
    <div class="card__content"><slot /></div>
    <div class="card__footer"><slot name="footer" /></div>
  </div>
</div>

<style>
  .card { --fg: var(--text-body); --head: var(--text-strong); background: var(--surface-raised); color: var(--fg);
    border-radius: var(--radius-lg); overflow: hidden; display: flex; flex-direction: column;
    transition: box-shadow var(--dur-base) var(--ease-soft), transform var(--dur-base) var(--ease-soft); }
  .card--sand { background: var(--surface-sand); }
  .card--sage { background: var(--surface-sage); --fg: var(--rh-espresso); --head: var(--rh-espresso); }
  .card--olive { background: var(--surface-olive); --fg: var(--rh-ivory); --head: var(--rh-ivory); }
  .card--terracotta { background: var(--surface-terracotta); --fg: var(--text-on-dark-muted); --head: var(--rh-ivory); }
  .card--espresso { background: var(--surface-moody); --fg: var(--text-on-dark-muted); --head: var(--rh-ivory); }
  .card--interactive:hover { box-shadow: var(--shadow-lift); transform: translateY(-4px); }
  .card__body { padding: 28px 28px 30px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .card__eyebrow { font-size: 11px; font-weight: 500; letter-spacing: .24em; text-transform: uppercase; opacity: .85; }
  .card__head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .card__title { margin: 0; font-family: var(--font-display); font-weight: 400; font-size: 26px; line-height: 1.15; color: var(--head); }
  .card__price { font-family: var(--font-display); font-size: 20px; color: var(--head); white-space: nowrap; }
  .card__content { font-size: 15px; line-height: 1.7; }
  .card__footer { margin-top: auto; padding-top: 12px; }
</style>
