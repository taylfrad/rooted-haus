---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  shape?: 'arch' | 'circle' | 'rounded' | 'soft';
  ratio?: string;
  label?: string;
  /** Stretch to fill the parent (used in the gallery mosaic) instead of keeping `ratio`. */
  fill?: boolean;
  /** Hint to the browser for picking an image size. */
  sizes?: string;
  /** Which part of the photo to keep when cropping (CSS object-position), e.g. "50% 20%" keeps the upper middle. */
  focus?: string;
}
const {
  src,
  alt = '',
  shape = 'arch',
  ratio = '4 / 5',
  label = 'Photo',
  fill = false,
  sizes = '(min-width: 900px) 40vw, 90vw',
  focus,
} = Astro.props;
---

<div class:list={['pf', `pf--${shape}`, { 'pf--fill': fill }]} style={`--ratio:${shape === 'circle' ? '1 / 1' : ratio}`}>
  {src ? <Image src={src} alt={alt} widths={[400, 800, 1200, 1600]} sizes={sizes} class="pf__img" style={focus ? `object-position:${focus}` : undefined} /> : <span class="pf__label">{label}</span>}
</div>

<style>
  .pf { position: relative; overflow: hidden; aspect-ratio: var(--ratio);
    background: linear-gradient(160deg, var(--rh-sand), var(--rh-caramel-soft)); }
  .pf--fill { aspect-ratio: auto; width: 100%; height: 100%; }
  .pf--arch { border-radius: var(--radius-arch); }
  .pf--circle { border-radius: 50%; }
  .pf--rounded { border-radius: var(--radius-lg); }
  .pf--soft { border-radius: var(--radius-md); }
  .pf__img { width: 100%; height: 100%; object-fit: cover; filter: var(--photo-warmth); }
  .pf__label { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    padding: 16px; text-align: center; font-size: 11px; letter-spacing: .2em; text-transform: uppercase;
    color: var(--rh-chocolate-70); }
</style>
