---
// The RH monogram (design system: sand monogram). Sits in the flow above a heading, whole, with nothing on top of it.
import { Image } from 'astro:assets';
import monogram from '../assets/monogram-sand.png';

interface Props {
  /** Line it up with a centered heading or a left-aligned one. */
  align?: 'left' | 'center';
}
const { align = 'center' } = Astro.props;
---

<Image src={monogram} alt="" aria-hidden="true" width={640} class:list={['wm', `wm--${align}`]} loading="lazy" />

<style>
  .wm { display: block; height: clamp(110px, 12vw, 170px); width: auto; opacity: .55; margin: 0 auto var(--space-5); pointer-events: none; user-select: none; }
  .wm--left { margin-left: 0; }
</style>
