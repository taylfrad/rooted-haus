---
import Button from './core/Button.astro';
import { nav, site, hoursLine } from '../lib/site';
import { url } from '../lib/paths';
---

<footer class="footer">
  <div class="footer__grid">
    <div class="footer__brand">
      <span class="footer__mark">rh</span>
      <span class="footer__script">come as you are</span>
    </div>
    <div class="footer__col">
      <span class="footer__h">Visit</span>
      <span>{site.address.line1}</span>
      <span>{site.address.city}</span>
      {site.hours.map((h) => <span>{hoursLine(h)}</span>)}
      <a href={url('directions/')}>Directions</a>
    </div>
    <div class="footer__col">
      <span class="footer__h">Explore</span>
      {nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
      <a href={url('reviews/')}>Reviews</a>
      <a href={url('faq/')}>FAQ</a>
      {site.giftCardsUrl && <a href={site.giftCardsUrl} target="_blank" rel="noopener">Gift cards</a>}
    </div>
    <div class="footer__col">
      <span class="footer__h">Stay rooted</span>
      <span>News, openings and product drops.</span>
      <div><Button variant="outline" tone="dark" size="sm" href={url('contact/')}>Join the list</Button></div>
      <div class="footer__social">
        <a href={site.instagram} aria-label="Instagram" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" fill="currentColor" /></svg>
        </a>
        <a href={site.facebook} aria-label="Facebook" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z" /></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="footer__legal">
    <span>{site.name} · {site.tagline}</span>
    <span>rootedhaus.com</span>
  </div>
</footer>

<style>
  .footer { background: var(--surface-moody); color: var(--rh-ivory); }
  .footer__grid { max-width: 1280px; margin: 0 auto; padding: 80px var(--gutter) 40px; display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr; gap: 48px; }
  .footer__brand { display: flex; flex-direction: column; gap: 18px; }
  .footer__mark { font-family: var(--font-display); font-size: 64px; line-height: 1; color: var(--rh-sand); }
  .footer__script { font-family: var(--font-script); font-size: 34px; color: var(--rh-caramel-soft); }
  .footer__col { display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: var(--text-on-dark-muted); }
  .footer__col a { color: var(--text-on-dark-muted); text-decoration: none; }
  .footer__col a:hover { color: var(--rh-ivory); text-decoration: underline; }
  .footer__h { font-size: 11px; font-weight: 500; letter-spacing: .28em; text-transform: uppercase;
    color: var(--rh-sand); margin-bottom: 6px; }
  .footer__social { display: flex; gap: 10px; margin-top: 8px; }
  .footer__social a { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%;
    border: 1px solid var(--border-on-dark); color: var(--rh-ivory); }
  .footer__social a:hover { background: var(--rh-ivory); color: var(--rh-espresso); text-decoration: none; }
  .footer__legal { max-width: 1280px; margin: 0 auto; padding: 20px var(--gutter) 32px; display: flex;
    justify-content: space-between; gap: 16px; flex-wrap: wrap; border-top: 1px solid var(--border-on-dark);
    font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--text-on-dark-muted); }
  @media (max-width: 900px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .footer__grid { grid-template-columns: 1fr; padding-top: 56px; } }
</style>
