---
import { Image } from 'astro:assets';
import Button from './core/Button.astro';
import monogram from '../assets/monogram-sand.png';
import DirectionsMap from './DirectionsMap.astro';
import { nav, site } from '../lib/site';
import { url } from '../lib/paths';
---

<!-- transition:persist keeps the footer (and its map) in place between pages, so the map is not reloaded on every click. -->
<footer class="footer" transition:persist>
  <div class="footer__grid">
    <div class="footer__brand">
      <a class="footer__mark" href={url()} aria-label={`${site.name} home`}>
        <Image src={monogram} alt="" width={112} densities={[1, 2]} />
      </a>
      <span class="footer__script">{site.footerScript}</span>
    </div>

    <div class="footer__col footer__visit">
      <span class="footer__h">Visit</span>
      <address class="footer__address">
        <span>{site.address.line1}</span>
        <span>{site.address.city}</span>
      </address>
      <DirectionsMap compact />
    </div>

    <div class="footer__col footer__hours">
      <span class="footer__h">Hours</span>
      <dl class="hours">
        {site.hours.map((h) => (
          <div class:list={['hours__row', { 'hours__row--single': !h.time }]}>
            <dt>{h.days}</dt>
            {h.time && <dd>{h.time}</dd>}
          </div>
        ))}
      </dl>
    </div>

    <div class="footer__col footer__explore">
      <span class="footer__h">Explore</span>
      {nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
      <a href={url('careers/')}>Plant Your Roots</a>
      {site.giftCardsUrl && <a href={site.giftCardsUrl} target="_blank" rel="noopener">Gift cards</a>}
    </div>

    <div class="footer__col">
      <span class="footer__h">Stay rooted</span>
      {/* The signup line and button appear with the newsletter form on Connect (once a form address is set). */}
      {site.formsReady && <span>{site.footerNewsletter}</span>}
      {site.formsReady && <div><Button variant="outline" tone="dark" size="sm" href={url('contact/#newsletter')}>Join the list</Button></div>}
      <div class="footer__social">
        <a href={site.instagram} aria-label="Instagram" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" fill="currentColor" /></svg>
        </a>
        <a href={site.facebook} aria-label="Facebook" rel="noopener" target="_blank">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z" /></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="footer__legal">
    <span>{site.name} · {site.tagline}</span>
    <span>{site.websiteName}</span>
  </div>
</footer>

<style>
  .footer { background: var(--surface-moody); color: var(--rh-ivory); }
  .footer__grid { max-width: var(--container-max); margin: 0 auto; padding: 80px var(--gutter) 48px; display: grid;
    grid-template-columns: 0.95fr 1.35fr 1fr 0.8fr 1.1fr; gap: 40px; align-items: start; }
  .footer__brand { display: flex; flex-direction: column; gap: 18px; }
  .footer__mark { display: block; width: 112px; border-radius: 50%; }
  .footer__mark :global(img) { width: 100%; height: auto; }
  .footer__script { font-family: var(--font-script); font-size: 30px; line-height: 1.1; white-space: nowrap; color: var(--rh-caramel-soft); }
  .footer__col { display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: var(--text-on-dark-muted); }
  .footer__col a { color: var(--text-on-dark-muted); text-decoration: none; }
  .footer__col a:hover { color: var(--rh-ivory); text-decoration: underline; }
  .footer__h { font-size: 11px; font-weight: 500; letter-spacing: .28em; text-transform: uppercase; color: var(--rh-sand); margin-bottom: 6px; }

  .footer__address { display: flex; flex-direction: column; gap: 2px; font-style: normal; font-size: 15px; color: var(--rh-ivory); margin-bottom: 8px; }

  /* Hours is its own narrow column, so each row stacks the day over the time. */
  .hours { margin: 0; display: flex; flex-direction: column; }
  .hours__row { display: flex; flex-direction: column; gap: 2px; padding: 11px 0; border-bottom: 1px solid var(--border-on-dark); }
  .hours__row:first-child { border-top: 1px solid var(--border-on-dark); }
  .hours dt { font-size: 13px; color: var(--text-on-dark-muted); }
  .hours dd { margin: 0; font-size: 15px; color: var(--rh-ivory); font-variant-numeric: tabular-nums; }
  .hours__row--single dt { font-size: 15px; color: var(--rh-ivory); }

  .footer__social { display: flex; gap: 10px; margin-top: 8px; }
  .footer__social a { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%;
    border: 1px solid var(--border-on-dark); color: var(--rh-ivory); }
  .footer__social a:hover { background: var(--rh-ivory); color: var(--rh-espresso); text-decoration: none; }
  /* Sized to the content width (not padded) so the rule above it ends where the columns do. */
  .footer__legal { width: min(var(--container-max), 100% - 2 * var(--gutter)); margin: 0 auto; padding: 20px 0 32px; display: flex;
    justify-content: space-between; gap: 16px; flex-wrap: wrap; border-top: 1px solid var(--border-on-dark);
    font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--text-on-dark-muted); }

  /* Tablet: brand across the top, then two columns (Visit | Hours, Explore | Stay rooted). */
  @media (max-width: 1179px) {
    .footer__grid { grid-template-columns: 1fr 1fr; gap: 48px 40px; }
    .footer__brand { grid-column: 1 / -1; flex-direction: row; align-items: center; gap: 28px; }
  }
  @media (max-width: 560px) {
    .footer__grid { grid-template-columns: 1fr; padding-top: 56px; }
    .footer__brand { flex-direction: column; align-items: flex-start; gap: 18px; }
    .footer__explore { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; }
    .footer__explore .footer__h { grid-column: 1 / -1; }
  }
</style>
