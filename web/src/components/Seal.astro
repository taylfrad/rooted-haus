---
// A small RH monogram between two fine lines. Closes a page above its last button, on pages without a closing band.
import monogram from '../assets/monogram-sand.png';

interface Props {
  /** The section it sits on. */
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
---

<div class:list={['seal', `seal--${tone}`]} aria-hidden="true">
  <span class="seal__rule"></span>
  <span class="seal__mark" style={`--mark:url(${monogram.src})`}></span>
  <span class="seal__rule"></span>
</div>

<style>
  .seal { --ink: var(--rh-chocolate-50); display: flex; align-items: center; justify-content: center; gap: 20px; margin: clamp(40px, 6vw, 72px) 0 clamp(32px, 4vw, 48px); }
  .seal--dark { --ink: color-mix(in srgb, var(--rh-sand) 70%, transparent); }
  .seal__rule { flex: 0 1 120px; height: 1px; background: var(--ink); }
  .seal__mark { flex: none; width: 64px; aspect-ratio: 640 / 579; background: var(--ink);
    -webkit-mask: var(--mark) center / contain no-repeat; mask: var(--mark) center / contain no-repeat; }
</style>
