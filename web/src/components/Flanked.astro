---
// Centered words with a frond on each side. The fronds only show on screens with clear room beside the words.
import Sprig from './Sprig.astro';

interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'dark' } = Astro.props;
---

<div class="flanked">
  <Sprig {tone} side="start" class="flanked__sprig flanked__sprig--left" />
  <slot />
  <Sprig {tone} side="end" class="flanked__sprig flanked__sprig--right" />
</div>

<style>
  .flanked { position: relative; }
  .flanked :global(.flanked__sprig) { display: none; position: absolute; top: 50%; width: 190px; margin: 0; translate: 0 -50%; }
  .flanked :global(.flanked__sprig--left) { left: 0; }
  .flanked :global(.flanked__sprig--right) { right: 0; }
  @media (min-width: 1280px) { .flanked :global(.flanked__sprig) { display: block; } }
</style>
